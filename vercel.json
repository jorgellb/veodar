{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/desarrollo-web",
      "destination": "/servicios/desarrollo-web/",
      "permanent": true
    },
    {
      "source": "/aplicaciones-escritorio",
      "destination": "/servicios/aplicaciones-escritorio/",
      "permanent": true
    },
    {
      "source": "/aplicaciones-moviles",
      "destination": "/servicios/aplicaciones-moviles/",
      "permanent": true
    },
    {
      "source": "/automatizaciones-ia",
      "destination": "/servicios/automatizaciones-ia/",
      "permanent": true
    },
    {
      "source": "/desarrollo-web/",
      "destination": "/servicios/desarrollo-web/",
      "permanent": true
    },
    {
      "source": "/aplicaciones-escritorio/",
      "destination": "/servicios/aplicaciones-escritorio/",
      "permanent": true
    },
    {
      "source": "/aplicaciones-moviles/",
      "destination": "/servicios/aplicaciones-moviles/",
      "permanent": true
    },
    {
      "source": "/automatizaciones-ia/",
      "destination": "/servicios/automatizaciones-ia/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(og.png|favicon.svg|favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|llms.txt|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
