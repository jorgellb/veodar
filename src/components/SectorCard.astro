---
// A sector on the /sectores/ hub: tinted stage with its animated drawing, the
// promise in one line and the systems we usually meet there.
import Icon from './Icon.astro';
import ServiceGlyph from './ServiceGlyph.astro';
import type { Sector } from '../data/sectors';
import { langOf, sectorHref } from '../i18n';

interface Props {
  sector: Sector;
}
const { sector } = Astro.props;
const lang = langOf(Astro.url);
const tintBg: Record<string, string> = {
  mint: 'bg-mint',
  sky: 'bg-sky',
  butter: 'bg-butter',
  blush: 'bg-blush',
  lilac: 'bg-lilac',
  paper: 'bg-paper-2',
};
---

<a href={sectorHref(sector.id, lang)} class="sec-card spot group" data-node>
  <span class:list={['sec-stage', tintBg[sector.tint]]}>
    <span class="sec-art"><ServiceGlyph slug={sector.id} /></span>
    <span class="sec-tag"><Icon name={sector.icon} size={15} /> {sector.short}</span>
  </span>
  <span class="sec-body">
    <span class="block font-display text-[clamp(1.7rem,2.4vw,2.2rem)] leading-[1] tracking-[-0.03em]">{sector.name}</span>
    <span class="mt-3 block max-w-[40ch] text-[15px] leading-relaxed text-muted">{sector.menu}</span>
    <span class="mt-5 flex flex-wrap gap-1.5">
      {sector.stack.slice(0, 4).map((system) => <span class="chip">{system}</span>)}
    </span>
  </span>
  <span class="sec-go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
</a>

<style>
  .sec-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 10px;
    border-radius: 26px;
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition:
      transform 0.5s var(--ease-spring),
      box-shadow 0.5s var(--ease-spring);
  }
  .sec-card:hover {
    transform: translateY(-4px);
    box-shadow:
      inset 0 0 0 1px var(--color-ink),
      0 24px 40px -24px rgb(22 20 44 / 0.45);
  }
  .sec-stage {
    position: relative;
    display: grid;
    place-items: center;
    height: 200px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgb(22 20 44 / 0.06);
    --glyph-paper: rgb(255 255 255 / 0.72);
  }
  .sec-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(22 20 44 / 0.12) 1px, transparent 1px);
    background-size: 14px 14px;
    mask-image: linear-gradient(180deg, transparent, #000 140%);
  }
  .sec-art {
    position: relative;
    width: 210px;
    aspect-ratio: 4 / 3;
    transition: transform 0.6s var(--ease-spring);
  }
  .sec-card:hover .sec-art {
    transform: scale(1.05);
  }
  .sec-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 5px 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.6);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: rgb(22 20 44 / 0.75);
  }
  .sec-body {
    display: block;
    padding: 24px 64px 18px 16px;
  }
  .sec-go {
    position: absolute;
    right: 20px;
    bottom: 20px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.5s var(--ease-spring);
  }
  .sec-card:hover .sec-go {
    background: var(--color-accent);
    color: #1a0a03;
    box-shadow: none;
    transform: rotate(-45deg);
  }
</style>
