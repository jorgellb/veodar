---
import Icon from './Icon.astro';
import Figure from './iso/Figure.astro';
import { langOf, pathTo } from '../i18n';

interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
}

const lang = langOf(Astro.url);
const T = {
  es: {
    title: '¿Qué se sigue haciendo a mano en tu empresa?',
    text: 'Mándanos el ejemplo de esta semana: el correo, el parte o la hoja de cálculo. Te decimos si es web, móvil, escritorio o una automatización con IA, y si encaja.',
    label: 'Cuéntanos tu proyecto',
    eyebrow: 'Empezar',
    figure: 'Manipulador Morse',
  },
  en: {
    title: 'What is still done by hand at your company?',
    text: "Send us this week's example: the email, the report or the spreadsheet. We'll tell you whether it's web, mobile, desktop or an AI automation, and if it fits.",
    label: 'Tell us about your project',
    eyebrow: 'Get started',
    figure: 'Morse key',
  },
}[lang];
const { title = T.title, text = T.text, href = pathTo('contacto', lang), label = T.label } = Astro.props;
// Two more ways forward for whoever is not ready to write: never the page they are on.
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const more = (
  [
    { key: 'precios', es: ['', 'cómo presupuestamos un proyecto'], en: ['', 'how we price a project'] },
    { key: 'soluciones', es: ['las ', 'soluciones por área de la empresa'], en: ['our ', 'solutions by department'] },
    { key: 'sectores', es: ['los ', 'sectores con los que trabajamos'], en: ['the ', 'industries we work with'] },
    { key: 'servicios', es: ['', 'todos nuestros servicios'], en: ['', 'all our services'] },
  ] as const
)
  .filter((item) => pathTo(item.key, lang) !== here)
  .slice(0, 2)
  .map((item) => ({ href: pathTo(item.key, lang), lead: item[lang][0], anchor: item[lang][1] }));
const moreText = { es: ['¿Antes de escribir? Mira ', ' o ', '.'], en: ['Before you write, see ', ' or ', '.'] }[lang];
---

<section class="px-3 pb-3 md:px-5 md:pb-5" data-spine="0.544" aria-labelledby="cta-title">
  <div class="cta overflow-hidden rounded-[32px] bg-blush">
    <div class="wrap grid items-center gap-10 py-16 md:py-20 lg:grid-cols-[1.2fr_1fr]">
      <div data-reveal>
        <p class="eyebrow !text-ink-2">{T.eyebrow}</p>
        <h2 id="cta-title" class="display h-xl mt-5 max-w-[15ch]">{title}</h2>
        <p class="lead mt-6 max-w-[48ch]">{text}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={href} class="btn btn-primary">{label} <Icon name="arrow" size={17} class="arrow" /></a>
          <a href="mailto:info@veodar.com" class="btn btn-ghost">info@veodar.com</a>
        </div>
        <p class="mt-7 max-w-[52ch] text-[14.5px] leading-relaxed text-ink-2">
          {moreText[0]}{more[0].lead}<a href={more[0].href} class="ctx-link">{more[0].anchor}</a>{moreText[1]}{more[1].lead}<a href={more[1].href} class="ctx-link">{more[1].anchor}</a>{moreText[2]}
        </p>
      </div>
      <div data-reveal style="--d:120ms">
        <Figure name="telegraph" fig="Fig. 07" title={T.figure} hint={lang === 'en' ? 'H · E · L · L · O' : 'H · O · L · A'} bare lazy />
      </div>
    </div>
  </div>
</section>
