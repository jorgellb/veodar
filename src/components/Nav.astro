---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ServiceGlyph from './ServiceGlyph.astro';
import LangSwitch from './LangSwitch.astro';
import { servicesFor, serviceHref } from '../data/services';
import { sectorsFor } from '../data/sectors';
import { askAiFor } from '../data/site';
import { groupsFor, techById } from '../data/technologies';
import { langOf, pathTo, sectorHref, techIdOf } from '../i18n';

interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const lang = langOf(Astro.url);
const services = servicesFor(lang);
const href = (id: string) => serviceHref(id, lang);
const askAi = askAiFor(lang);
const sectors = sectorsFor(lang);

const engineering = services.filter((service) => service.group === 'ingenieria');
const studio = services.filter((service) => service.group === 'estudio');
const featured = engineering[0];
const engineeringRest = engineering.slice(1);
// The groups of technologies: each hangs, as a second way in, from the service it belongs to.
const techGroups = groupsFor(lang);
const techGroupOf = new Map(techGroups.map((group) => [group.service, group]));

const T = {
  es: {
    home: 'Veodar, inicio',
    main: 'Principal',
    services: 'Servicios',
    solutions: 'Soluciones',
    sectors: 'Sectores',
    resources: 'Recursos',
    pricing: 'Precios',
    contact: 'Contacto',
    cta: 'Cuéntanos tu proyecto',
    openMenu: 'Abrir menú',
    closeMenu: 'Cerrar menú',
    menu: 'Menú',
    popular: 'Lo más pedido',
    seeService: 'Ver el servicio',
    engineering: 'Ingeniería',
    studio: 'Estudio',
    allServices: 'Todos los servicios',
    unsure: '¿No sabes qué formato necesitas? Cuéntanos el problema y lo proponemos nosotros.',
    byArea: 'Por área de la empresa',
    teamFirst: 'Un equipo primero',
    teamFirstText: 'Cada área encarga lo suyo. La lista de producción es una.',
    seeSolutions: 'Ver soluciones',
    askAi: 'Pregúntale a una IA',
    askAiText: '¿Quién es Veodar? Que te lo cuente tu asistente.',
    rowsServices: `Ingeniería y estudio · ${services.length}`,
    rowsSolutions: 'Por área de la empresa · 6',
    rowsSectors: `Por sector · ${sectors.length}`,
    bySector: 'Por sector',
    sectorsLine: 'El oficio es el mismo. El problema, no.',
    seeSectors: 'Ver todos los sectores',
    sectorsChip: 'Sectores',
    rowsResources: 'Proceso, glosario y contacto',
    rowsPricing: 'Cómo se escribe un presupuesto',
    resourcesCap: 'Proceso, glosario, preguntas y contacto · 5',
  },
  en: {
    home: 'Veodar, home',
    main: 'Main',
    services: 'Services',
    solutions: 'Solutions',
    sectors: 'Industries',
    resources: 'Resources',
    pricing: 'Pricing',
    contact: 'Contact',
    cta: 'Tell us about your project',
    openMenu: 'Open menu',
    closeMenu: 'Close menu',
    menu: 'Menu',
    popular: 'Most requested',
    seeService: 'See the service',
    engineering: 'Engineering',
    studio: 'Studio',
    allServices: 'All services',
    unsure: "Not sure which format you need? Tell us the problem and we'll propose one.",
    byArea: 'By department',
    teamFirst: 'One team first',
    teamFirstText: 'Each department commissions its own work. The production list stays one.',
    seeSolutions: 'See solutions',
    askAi: 'Ask an AI',
    askAiText: 'Who is Veodar? Let your assistant tell you.',
    rowsServices: `Engineering & studio · ${services.length}`,
    rowsSolutions: 'By department · 6',
    rowsSectors: `By industry · ${sectors.length}`,
    bySector: 'By industry',
    sectorsLine: 'Same craft. Different problem.',
    seeSectors: 'See all industries',
    sectorsChip: 'Industries',
    rowsResources: 'Process, glossary and contact',
    rowsPricing: 'How a quote gets written',
    resourcesCap: 'Process, glossary, questions and contact · 5',
  },
}[lang];

const areaText = {
  es: [
    ['TI', 'Marco, accesos y despliegue'],
    ['Seguridad', 'Qué dato, qué credencial'],
    ['Finanzas', 'Cierres sin copiar cifras'],
    ['Personas', 'Altas y documentos que faltan'],
    ['RevOps', 'Estados que el CRM no obliga'],
    ['Legal', 'Plazos, versiones y aceptaciones'],
  ],
  en: [
    ['IT', 'Frame, access and deployment'],
    ['Security', 'Which data, which credential'],
    ['Finance', 'Closing without copying figures'],
    ['People', 'Onboarding and missing documents'],
    ['RevOps', 'Stages the CRM doesn’t enforce'],
    ['Legal', 'Deadlines, versions and approvals'],
  ],
}[lang];
const areas = ['ti', 'seguridad', 'finanzas', 'personas', 'revops', 'legal'].map((id, i) => ({
  name: areaText[i][0],
  desc: areaText[i][1],
  href: pathTo('soluciones', lang, id),
  icon: ['layers', 'shield', 'tag', 'mail', 'sliders', 'key'][i],
}));

const resourceText = {
  es: [
    ['Precios', 'Cómo se escribe un presupuesto'],
    ['Cómo trabajamos', 'Construir, desplegar, operar'],
    ['Glosario', 'Las siglas, explicadas sin jerga'],
    ['Preguntas frecuentes', 'Lo que nos preguntan siempre'],
    ['Contacto', 'El siguiente paso, por correo'],
  ],
  en: [
    ['Pricing', 'How a quote gets written'],
    ['How we work', 'Build, deploy, operate'],
    ['Glossary', 'The acronyms, explained plainly'],
    ['FAQ', 'What we always get asked'],
    ['Contact', 'The next step, by email'],
  ],
}[lang];
const resources = [
  { href: pathTo('precios', lang), icon: 'tag' },
  { href: pathTo('home', lang, 'proceso'), icon: 'compass' },
  { href: pathTo('glosario', lang), icon: 'layers' },
  { href: pathTo('home', lang, 'preguntas'), icon: 'search' },
  { href: pathTo('contacto', lang), icon: 'mail' },
].map((item, i) => ({ ...item, name: resourceText[i][0], desc: resourceText[i][1] }));

// Phone menu: the four rows on the fibre, and what each one opens.
const path = Astro.url.pathname;
// On a technology page, the group it belongs to; on the index, the first.
const techSlug = path.match(/^\/(?:en\/technologies|tecnologias)\/(?:([^/]+)\/)?$/);
const hereGroup = techSlug ? (techSlug[1] ? techById(techIdOf(techSlug[1], lang) ?? '', lang)?.group : techGroups[0].id) : undefined;
const here =
  /^\/(en\/services|servicios|en\/technologies|tecnologias)\//.test(path) ? 'servicios'
  : /^\/(en\/solutions|soluciones)\//.test(path) ? 'soluciones'
  : /^\/(en\/industries|sectores)\//.test(path) ? 'sectores'
  : /^\/(en\/pricing|precios)\//.test(path) ? 'precios'
  : '';
const rows = [
  { id: 'servicios', name: T.services, cap: T.rowsServices },
  { id: 'soluciones', name: T.solutions, cap: T.rowsSolutions },
  { id: 'sectores', name: T.sectors, cap: T.rowsSectors },
  { id: 'recursos', name: T.resources, cap: T.rowsResources },
  { id: 'precios', name: T.pricing, cap: T.rowsPricing, href: pathTo('precios', lang) },
];

// The fibre mesh behind the phone menu: a jittered grid from a fixed seed, so every build draws the same one.
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const MW = 400;
const MH = 900;
const COLS = 6;
const ROWS = 13;
const grid = Array.from({ length: ROWS }, (_, r) =>
  Array.from({ length: COLS }, (_, c) => [
    (c + 0.5) * (MW / COLS) + (rnd() - 0.5) * (MW / COLS) * 0.75,
    (r + 0.5) * (MH / ROWS) + (rnd() - 0.5) * (MH / ROWS) * 0.75,
  ]),
);
const edges: number[][][] = [];
for (let r = 0; r < ROWS; r++) {
  for (let c = 0; c < COLS; c++) {
    if (c < COLS - 1 && rnd() < 0.72) edges.push([grid[r][c], grid[r][c + 1]]);
    if (r < ROWS - 1 && rnd() < 0.68) edges.push([grid[r][c], grid[r + 1][c]]);
    if (r < ROWS - 1 && c < COLS - 1 && rnd() < 0.22) edges.push([grid[r][c], grid[r + 1][c + 1]]);
  }
}
const seg = ([a, b]: number[][]) => `M${a[0].toFixed(1)} ${a[1].toFixed(1)}L${b[0].toFixed(1)} ${b[1].toFixed(1)}`;
const meshLines = edges.map(seg).join('');
const meshFlows = edges.filter((_, i) => i % 7 === 3).map((edge, i) => ({ d: seg(edge), delay: ((i * 0.73) % 3.2).toFixed(2) }));
const meshNodes = grid.flat();

const tintVar: Record<string, string> = {
  mint: 'var(--color-mint)',
  sky: 'var(--color-sky)',
  butter: 'var(--color-butter)',
  blush: 'var(--color-blush)',
  lilac: 'var(--color-lilac)',
  paper: 'var(--color-paper-2)',
};

const tintBg: Record<string, string> = {
  mint: 'bg-mint',
  sky: 'bg-sky',
  butter: 'bg-butter',
  blush: 'bg-blush',
  lilac: 'bg-lilac',
  paper: 'bg-paper-2',
};
---

<header class="site-header" data-nav data-tone={tone}>
  <div class="wrap flex h-[68px] items-center gap-2">
    <a href="/" class="mr-3 shrink-0" aria-label={T.home}>
      <Logo />
    </a>

    <nav class="hidden items-center lg:flex" aria-label={T.main}>
      <ul class="flex items-center">
        <li>
          <button type="button" class="nav-trigger" data-trigger="servicios" aria-expanded="false" aria-controls="panel-servicios">
            {T.services} <Icon name="chevron" size={14} class="chev" />
          </button>
        </li>
        <li>
          <button type="button" class="nav-trigger" data-trigger="soluciones" aria-expanded="false" aria-controls="panel-soluciones">
            {T.solutions} <Icon name="chevron" size={14} class="chev" />
          </button>
        </li>
        <li>
          <button type="button" class="nav-trigger" data-trigger="sectores" aria-expanded="false" aria-controls="panel-sectores">
            {T.sectors} <Icon name="chevron" size={14} class="chev" />
          </button>
        </li>
        <li>
          <button type="button" class="nav-trigger" data-trigger="recursos" aria-expanded="false" aria-controls="panel-recursos">
            {T.resources} <Icon name="chevron" size={14} class="chev" />
          </button>
        </li>
        <li><a href={pathTo('precios', lang)} class="nav-trigger">{T.pricing}</a></li>
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <LangSwitch />
      <a href={pathTo('contacto', lang)} class="nav-trigger nav-contact">{T.contact}</a>
      <a href={pathTo('contacto', lang)} class="btn btn-primary hidden !min-h-[40px] !px-4 !text-[14px] sm:inline-flex">
        {T.cta} <Icon name="arrow" size={16} class="arrow" />
      </a>
      <button type="button" class="nav-burger lg:hidden" aria-label={T.openMenu} aria-expanded="false" aria-controls="menu-movil" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Desktop mega menu: one morphing surface, three panels -->
  <div class="mega" data-mega hidden>
    <div class="mega-surface" data-surface>
      <div class="mega-panel" id="panel-servicios" data-panel="servicios" role="region" aria-label={T.services}>
        <div class="grid w-[1080px] grid-cols-[300px_1fr_1.35fr] gap-2 p-2">
          <a href={href(featured.slug)} class="feature-card spot bg-ink text-paper">
            <span class="chip !bg-white/10 !text-paper !shadow-none">{T.popular}</span>
            <span class="mt-auto">
              <span class="block font-display text-[30px] leading-[0.98] tracking-[-0.03em]">{featured.name}</span>
              <span class="mt-2 block text-[14px] leading-snug text-paper/75">{featured.menu}</span>
              <span class="mt-4 inline-flex items-center gap-1.5 text-[14px] font-medium text-accent">
                {T.seeService} <Icon name="arrow" size={15} />
              </span>
            </span>
            <span class="feature-art"><ServiceGlyph slug={featured.slug} /></span>
          </a>

          <div class="mega-col">
            <p class="mega-label">{T.engineering}</p>
            <ul class="grid gap-0.5">
              {
                engineeringRest.map((service) => (
                  <li>
                    <a href={href(service.slug)} class="mega-link">
                      <span class:list={['mega-ico', tintBg[service.tint]]}>
                        <Icon name={service.icon} size={19} />
                      </span>
                      <span>
                        <span class="mega-name">{service.name}</span>
                        <span class="mega-desc">{service.menu}</span>
                      </span>
                    </a>
                    {techGroupOf.get(service.slug) && (
                      <a href={techGroupOf.get(service.slug)!.href} class="mega-sub">
                        <span class="mega-sub-name">
                          {techGroupOf.get(service.slug)!.menu.name} <Icon name="arrow" size={13} />
                        </span>
                        <span class="mega-sub-desc">{techGroupOf.get(service.slug)!.menu.desc}</span>
                      </a>
                    )}
                  </li>
                ))
              }
            </ul>
            <a href={pathTo('servicios', lang)} class="mega-foot">
              {T.allServices} <Icon name="arrow" size={15} />
            </a>
          </div>

          <div class="mega-col">
            <p class="mega-label">{T.studio}</p>
            <ul class="grid grid-cols-2 gap-0.5">
              {
                studio.map((service) => (
                  <li>
                    <a href={href(service.slug)} class="mega-link mega-link--compact">
                      <span class:list={['mega-ico mega-ico--sm', tintBg[service.tint]]}>
                        <Icon name={service.icon} size={16} />
                      </span>
                      <span>
                        <span class="mega-name">{service.name}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="mega-note">
              <Icon name="spark" size={16} class="text-accent-ink" />
              <span>{T.unsure}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="mega-panel" id="panel-soluciones" data-panel="soluciones" role="region" aria-label={T.solutions}>
        <div class="grid w-[820px] grid-cols-[1fr_260px] gap-2 p-2">
          <div class="mega-col">
            <p class="mega-label">{T.byArea}</p>
            <ul class="grid grid-cols-2 gap-0.5">
              {
                areas.map((area) => (
                  <li>
                    <a href={area.href} class="mega-link">
                      <span class="mega-ico bg-paper-2">
                        <Icon name={area.icon} size={18} />
                      </span>
                      <span>
                        <span class="mega-name">{area.name}</span>
                        <span class="mega-desc">{area.desc}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <a href={pathTo('soluciones', lang)} class="feature-card spot bg-mint text-ink">
            <span class="chip">{T.teamFirst}</span>
            <span class="mt-auto">
              <span class="block font-display text-[26px] leading-[1] tracking-[-0.03em]">{T.teamFirstText}</span>
              <span class="mt-4 inline-flex items-center gap-1.5 text-[14px] font-medium">{T.seeSolutions} <Icon name="arrow" size={15} /></span>
            </span>
          </a>
        </div>
      </div>

      <div class="mega-panel" id="panel-sectores" data-panel="sectores" role="region" aria-label={T.sectors}>
        <div class="grid w-[880px] grid-cols-[1fr_270px] gap-2 p-2">
          <div class="mega-col">
            <p class="mega-label">{T.bySector} · {sectors.length}</p>
            <ul class="grid grid-cols-3 gap-0.5">
              {
                sectors.map((sector) => (
                  <li>
                    <a href={sectorHref(sector.id, lang)} class="mega-link mega-link--compact" title={sector.menu}>
                      <span class:list={['mega-ico mega-ico--sm', tintBg[sector.tint]]}>
                        <Icon name={sector.icon} size={16} />
                      </span>
                      <span>
                        <span class="mega-name">{sector.name}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href={pathTo('sectores', lang)} class="mega-foot">
              {T.seeSectors} <Icon name="arrow" size={15} />
            </a>
          </div>
          <a href={pathTo('sectores', lang)} class="feature-card spot bg-butter text-ink">
            <span class="chip">{T.sectorsChip}</span>
            <span class="feature-art feature-art--sector"><ServiceGlyph slug="industria" /></span>
            <span class="mt-auto">
              <span class="block font-display text-[22px] leading-[1.02] tracking-[-0.03em]">{T.sectorsLine}</span>
              <span class="mt-4 inline-flex items-center gap-1.5 text-[14px] font-medium">{T.seeSectors} <Icon name="arrow" size={15} /></span>
            </span>
          </a>
        </div>
      </div>

      <div class="mega-panel" id="panel-recursos" data-panel="recursos" role="region" aria-label={T.resources}>
        <div class="grid w-[760px] grid-cols-[1fr_280px] gap-2 p-2">
          <div class="mega-col">
            <p class="mega-label">Veodar</p>
            <ul class="grid gap-0.5">
              {
                resources.map((item) => (
                  <li>
                    <a href={item.href} class="mega-link">
                      <span class="mega-ico bg-paper-2">
                        <Icon name={item.icon} size={18} />
                      </span>
                      <span>
                        <span class="mega-name">{item.name}</span>
                        <span class="mega-desc">{item.desc}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="feature-card bg-lilac text-ink">
            <span class="chip">{T.askAi}</span>
            <span class="mt-auto block font-display text-[24px] leading-[1.02] tracking-[-0.03em]">{T.askAiText}</span>
            <span class="mt-4 flex flex-wrap gap-1.5">
              {
                askAi.map((ai) => (
                  <a href={ai.href} target="_blank" rel="noopener" class="chip hover:!bg-white">
                    {ai.name}
                  </a>
                ))
              }
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

</header>
<div class="mega-scrim" data-scrim hidden></div>

<!-- Phone menu: a night panel that opens from the menu button like an iris. -->
<div class="msheet" id="menu-movil" data-sheet data-view="root" role="dialog" aria-modal="true" aria-label={T.menu} hidden>
  <svg class="ms-mesh" viewBox={`0 0 ${MW} ${MH}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <path class="ms-mesh-lines" d={meshLines}></path>
    {meshFlows.map((flow) => <path class="ms-flow" pathLength="100" d={flow.d} style={`--fd:${flow.delay}s`}></path>)}
    {meshNodes.map(([x, y], i) => <circle class:list={['ms-mesh-node', i % 9 === 4 && 'ms-mesh-hub']} cx={x.toFixed(1)} cy={y.toFixed(1)} r={i % 9 === 4 ? 2.4 : 1.3}></circle>)}
  </svg>

  <div class="ms-top">
    <div class="wrap flex h-[68px] items-center">
      <a href="/" class="shrink-0" aria-label={T.home}><Logo inverted /></a>
      <button type="button" class="ms-close" aria-label={T.closeMenu} data-close><span></span><span></span></button>
    </div>
  </div>

  <div class="ms-levels">
    <section class="ms-level" data-level="root" aria-label={T.menu}>
      <div class="wrap">
        <ul class="ms-list" style={`--n:${rows.length}`}>
          <li class="ms-packet" aria-hidden="true"></li>
          {
            rows.map((row, i) => (
              <li class="ms-item" style={`--i:${i}`} data-here={here === row.id ? '' : undefined}>
                {row.href ? (
                  <a href={row.href} class="ms-link" aria-current={here === row.id ? 'page' : undefined}>
                    <span class="ms-node" />
                    <span class="ms-name"><span>{row.name}</span></span>
                    <span class="ms-cap">{row.cap}</span>
                    <span class="ms-go"><Icon name="arrow" size={17} /></span>
                  </a>
                ) : (
                  <button type="button" class="ms-link" data-go={row.id} aria-expanded="false" aria-controls={`ms-${row.id}`}>
                    <span class="ms-node" />
                    <span class="ms-name"><span>{row.name}</span></span>
                    <span class="ms-cap">{row.cap}</span>
                    <span class="ms-go"><Icon name="chevron" size={18} class="ms-chev" /></span>
                  </button>
                )}
              </li>
            ))
          }
        </ul>

        <div class="ms-foot">
          <a href={pathTo('contacto', lang)} class="btn btn-accent ms-cta">{T.cta} <Icon name="arrow" size={17} class="arrow" /></a>
          <a href="mailto:info@veodar.com" class="ms-mail"><Icon name="mail" size={15} /> info@veodar.com</a>
          <div class="ms-lang"><LangSwitch variant="sheet" /></div>
        </div>
      </div>
    </section>

    <section class="ms-level" id="ms-servicios" data-level="servicios" aria-label={T.services} inert>
      <div class="ms-bar">
        <div class="wrap"><button type="button" class="ms-back" data-back><Icon name="chevron" size={17} class="ms-chev-back" /> {T.menu}</button></div>
      </div>
      <div class="wrap">
        <h2 class="ms-head"><span>{T.services}</span></h2>
        <p class="ms-head-cap">{T.engineering} · {engineering.length}</p>
        <ul class="ms-tiles">
          {
            engineering.map((service, i) => (
              <li class:list={['ms-tile', i === 0 && 'ms-tile--feature']} style={`--i:${i};--tint:${tintVar[service.tint]}`}>
                <a href={href(service.slug)} aria-current={path.startsWith(href(service.slug)) ? 'page' : undefined}>
                  <span class="ms-art"><ServiceGlyph slug={service.slug} /></span>
                  <span class="ms-tile-text">
                    {i === 0 && <span class="ms-flag">{T.popular}</span>}
                    <span class="ms-tile-name">{service.name}</span>
                    <span class="ms-tile-desc">{service.menu}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        {
          techGroups.map((group) => (
            <a href={group.href} class="ms-sub" aria-current={group.id === hereGroup ? 'page' : undefined}>
              <span>
                <span class="ms-sub-name">{group.menu.name}</span>
                <span class="ms-sub-desc">{group.menu.desc}</span>
              </span>
              <Icon name="arrow" size={17} />
            </a>
          ))
        }
        <p class="ms-head-cap ms-head-cap--sub">{T.studio} · {studio.length}</p>
        <ul class="ms-tiles">
          {
            studio.map((service, i) => (
              <li class="ms-tile" style={`--i:${i + engineering.length};--tint:${tintVar[service.tint]}`}>
                <a href={href(service.slug)} aria-current={path.startsWith(href(service.slug)) ? 'page' : undefined}>
                  <span class="ms-art"><ServiceGlyph slug={service.slug} /></span>
                  <span class="ms-tile-text">
                    <span class="ms-tile-name">{service.name}</span>
                    <span class="ms-tile-desc">{service.menu}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href={pathTo('servicios', lang)} class="ms-all">{T.allServices} <Icon name="arrow" size={16} /></a>
      </div>
    </section>

