    transform: none;
    transition:
      opacity 0.3s 0.06s,
      transform 0.42s var(--ease-spring);
  }
  /* Only a panel on its way in or out is offset. The active one always sits at 0,
     whatever direction it came from (these rules used to win over [data-active]). */
  .mega-panel:not([data-active])[data-from='left'] {
    transform: translateX(-28px);
  }
  .mega-panel:not([data-active])[data-from='right'] {
    transform: translateX(28px);
