  .nav-burger {
    place-content: center;
    gap: 6px;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  .nav-burger span {
    display: block;
    width: 18px;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.35s var(--ease-spring);
  }
  .nav-burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.8px) rotate(45deg);
  }
  .nav-burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.8px) rotate(-45deg);
  }

  /* ── Phone menu ───────────────────────────────────────────────────────
     A night panel that opens as an iris from the menu button. A fibre trunk
     runs down the rows; a packet of light travels it and lights each node. */
  .msheet[hidden] {
    display: none;
  }
  .msheet {
    --ix: calc(100% - 41px);
    --iy: 34px;
    --ir: 150vmax;
    position: fixed;
    inset: 0;
    z-index: 70;
    overflow: hidden;
    color: var(--color-paper);
    background:
      radial-gradient(520px 440px at 100% 0%, rgb(98 76 201 / 0.32), transparent 70%),
      radial-gradient(560px 520px at 0% 100%, rgb(255 90 31 / 0.15), transparent 70%),
      var(--color-night);
    clip-path: circle(0px at var(--ix) var(--iy));
    transition: clip-path 0.66s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .msheet[data-open] {
    clip-path: circle(var(--ir) at var(--ix) var(--iy));
  }
  .msheet[data-open][data-closing] {
    clip-path: circle(0px at var(--ix) var(--iy));
    transition-duration: 0.5s;
    transition-timing-function: cubic-bezier(0.6, 0, 0.35, 1);
  }
  /* The light the iris opens from: a flash at the button that settles into a glow. */
  .msheet::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(240px circle at var(--ix) var(--iy), rgb(255 90 31 / 0.5), transparent 70%);
    opacity: 0.32;
  }
  .msheet[data-open]::before {
    animation: ms-flash 1.2s var(--ease-out-soft) both;
  }
  @keyframes ms-flash {
    from {
      opacity: 1;
    }
  }

  .ms-mesh {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mask-image: linear-gradient(105deg, rgb(0 0 0 / 0.25) 15%, #000 75%);
  }
  .ms-mesh-lines {
    fill: none;
    stroke: var(--color-paper);
    stroke-opacity: 0.08;
    stroke-width: 0.8px;
    vector-effect: non-scaling-stroke;
  }
  .ms-mesh-node {
    fill: var(--color-paper);
    fill-opacity: 0.22;
  }
  .ms-mesh-hub {
    fill: var(--color-night);
    stroke: var(--color-paper);
    stroke-opacity: 0.35;
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }
  .ms-flow {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.4px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 9 91;
    stroke-dashoffset: 9;
    opacity: 0.85;
  }
  .msheet[data-open] .ms-flow {
    animation: ms-flow 3.2s linear infinite;
    animation-delay: var(--fd);
  }
  @keyframes ms-flow {
    from {
      stroke-dashoffset: 9;
    }
    to {
      stroke-dashoffset: -91;
    }
  }

  .ms-top {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
  }
  .ms-close {
    position: relative;
    display: inline-grid;
    place-content: center;
    width: 42px;
    height: 42px;
    margin-left: auto;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.3);
    transition: background-color 0.25s;
  }
  .ms-close:active {
    background: rgb(244 240 230 / 0.1);
  }
  .ms-close span {
    position: absolute;
    left: 12px;
    top: 20.2px;
    width: 18px;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    transform: rotate(45deg);
  }
  .ms-close span:last-child {
    transform: rotate(-45deg);
  }

  .ms-levels {
    position: absolute;
    inset: 68px 0 0;
    overflow: hidden;
  }
  .ms-level {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: calc(40px + env(safe-area-inset-bottom));
    transition:
      transform 0.6s var(--ease-spring),
      opacity 0.4s,
      visibility 0s 0.6s;
  }
  .ms-level[data-level='root'] {
    padding-top: 10px;
  }
  .ms-level:not([data-level='root']) {
    transform: translateX(100%);
    visibility: hidden;
  }
  .msheet:not([data-view='root']) .ms-level[data-level='root'] {
    transform: translateX(-28%);
    opacity: 0;
    visibility: hidden;
  }
  .msheet[data-view='servicios'] .ms-level[data-level='servicios'],
  .msheet[data-view='soluciones'] .ms-level[data-level='soluciones'],
  .msheet[data-view='sectores'] .ms-level[data-level='sectores'],
  .msheet[data-view='recursos'] .ms-level[data-level='recursos'],
  .msheet[data-view='root'] .ms-level[data-level='root'] {
    transform: none;
    opacity: 1;
    visibility: visible;
    transition:
      transform 0.6s var(--ease-spring),
      opacity 0.4s 0.05s,
      visibility 0s;
  }

  /* Rows on the trunk. Geometry is in em of the row type, so the nodes stay on the
     first line of each name at any size: node centre = 12px + 0.525em from the row top. */
  .ms-list {
    position: relative;
    padding-left: 36px;
    font-size: clamp(38px, 11vw, 66px);
  }
  .ms-list::before {
    content: '';
    position: absolute;
    left: 6px;
    top: calc(12px + 0.525em);
    bottom: calc(33px + 0.525em);
    width: 1.5px;
    background: linear-gradient(rgb(244 240 230 / 0.32), rgb(244 240 230 / 0.16));
    transform-origin: 50% 0;
  }
  .msheet[data-open] .ms-list::before {
    animation: ms-grow 0.9s var(--ease-out-soft) 0.22s both;
  }
  @keyframes ms-grow {
    from {
      transform: scaleY(0);
    }
  }
  .ms-link {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 12px;
    width: 100%;
    padding: 12px 0 14px;
    text-align: left;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* Branch from the trunk to the name. */
  .ms-link::before {
    content: '';
    position: absolute;
    left: -22px;
    top: calc(12px + 0.525em - 0.75px);
    width: 15px;
    height: 1.5px;
    background: rgb(244 240 230 / 0.3);
    transform-origin: 0 50%;
  }
  .msheet[data-open] .ms-link::before {
    animation: ms-branch 0.5s var(--ease-out-soft) both;
    animation-delay: calc(0.36s + var(--i) * 0.09s);
  }
  @keyframes ms-branch {
    from {
      transform: scaleX(0);
    }
  }
  .ms-node {
    position: absolute;
    left: -35.75px;
    top: calc(12px + 0.525em - 6.5px);
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--color-night);
    box-shadow:
      inset 0 0 0 1.5px rgb(244 240 230 / 0.5),
      0 0 0 0 rgb(255 90 31 / 0);
  }
  .ms-node::after {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    background: rgb(244 240 230 / 0.6);
  }
  .msheet[data-open] .ms-node {
    animation:
      ms-pop 0.55s var(--ease-spring) both,
      ms-ping 5.4s linear infinite;
    animation-delay:
      calc(0.3s + var(--i) * 0.09s),
      calc(1.7s + var(--i) * 1.8s / (var(--n) - 1));
  }
  @keyframes ms-pop {
    from {
      transform: scale(0);
    }
  }
  @keyframes ms-ping {
    0% {
      background: var(--color-accent);
      box-shadow:
        inset 0 0 0 1.5px var(--color-accent),
        0 0 0 5px rgb(255 90 31 / 0.22),
        0 0 22px rgb(255 90 31 / 0.85);
    }
    16%,
    100% {
      background: var(--color-night);
      box-shadow:
        inset 0 0 0 1.5px rgb(244 240 230 / 0.5),
        0 0 0 0 rgb(255 90 31 / 0),
        0 0 0 rgb(255 90 31 / 0);
    }
  }
  /* The section you are in keeps its node lit. */
  .ms-item[data-here] .ms-node,
  .msheet[data-open] .ms-item[data-here] .ms-node {
    background: var(--color-accent);
    box-shadow:
      inset 0 0 0 1.5px var(--color-accent),
      0 0 0 5px rgb(255 90 31 / 0.2),
      0 0 18px rgb(255 90 31 / 0.7);
    animation: ms-pop 0.55s var(--ease-spring) both;
    animation-delay: calc(0.3s + var(--i) * 0.09s);
  }
  .ms-item[data-here] .ms-node::after {
    background: #fff1e6;
  }
  .ms-item[data-here] .ms-cap::after {
    content: ' · Aquí';
    color: var(--color-accent);
  }
  :global(html[lang='en']) .ms-item[data-here] .ms-cap::after {
    content: ' · Here';
  }

  /* The packet that runs down the trunk, timed to light each node as it passes. */
  .ms-packet {
    position: absolute;
    left: 2.75px;
    top: calc(12px + 0.525em - 4px);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff1e6;
    box-shadow:
      0 0 0 2px var(--color-accent),
      0 0 16px 3px rgb(255 90 31 / 0.8);
    opacity: 0;
    pointer-events: none;
  }
  .ms-packet::before {
    content: '';
    position: absolute;
    left: 3px;
    bottom: 5px;
    width: 2px;
    height: 54px;
    border-radius: 2px;
    background: linear-gradient(rgb(255 90 31 / 0), var(--color-accent));
  }
  .msheet[data-open] .ms-packet {
    animation: ms-packet 5.4s linear 1.7s infinite;
  }
  @keyframes ms-packet {
    0% {
      top: calc(12px + 0.525em - 4px);
      opacity: 1;
    }
    33.333% {
      top: calc(100% - 33px - 0.525em - 4px);
      opacity: 1;
    }
    37%,
    100% {
      top: calc(100% - 33px - 0.525em - 4px);
      opacity: 0;
    }
  }

  .ms-name {
    grid-column: 1;
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
    font-family: var(--font-display);
    font-weight: 380;
    font-variation-settings: 'opsz' 40;
    line-height: 1.05;
    letter-spacing: -0.035em;
    transition: translate 0.35s var(--ease-spring);
  }
  .ms-name > span {
    display: block;
  }
  .msheet[data-open] .ms-name > span {
    animation: ms-rise 0.85s var(--ease-out-soft) both;
    animation-delay: calc(0.32s + var(--i) * 0.09s);
  }
  @keyframes ms-rise {
    from {
      transform: translateY(110%);
    }
  }
  .ms-link:active .ms-name {
    translate: 6px 0;
  }
  .ms-cap {
    grid-column: 1;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(244 240 230 / 0.52);
    /* One line, always: the trunk's geometry counts on every row being the same height. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ms-go {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.2);
    transition:
      background-color 0.25s,
      box-shadow 0.25s;
  }
  .ms-link:active .ms-go {
    background: var(--color-accent);
    color: #1a0a03;
    box-shadow: none;
  }
  .ms-go :global(.ms-chev) {
    transform: rotate(-90deg);
  }
  .msheet[data-open] :is(.ms-cap, .ms-go) {
    animation: ms-fade 0.6s var(--ease-out-soft) both;
    animation-delay: calc(0.5s + var(--i) * 0.09s);
  }
  @keyframes ms-fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .ms-foot {
    display: grid;
    gap: 16px;
    margin-top: 30px;
  }
  .msheet[data-open] .ms-foot {
    animation: ms-fade 0.7s var(--ease-out-soft) 0.78s both;
  }
  .ms-cta {
    width: 100%;
    min-height: 56px;
    font-size: 16px;
  }
  .ms-lang {
    display: flex;
    justify-content: center;
    margin-top: 6px;
  }
  .ms-mail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: rgb(244 240 230 / 0.7);
  }

  /* Second level: a bar with the way back, a heading, then the content. */
  .ms-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 6px 0 10px;
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .ms-level[data-scrolled] .ms-bar {
    background: rgb(18 16 38 / 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgb(244 240 230 / 0.08);
  }
  .ms-back {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 38px;
    padding: 0 15px 0 9px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 540;
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.24);
  }
  .ms-back :global(.ms-chev-back) {
    transform: rotate(90deg);
  }
  .ms-head {
    overflow: hidden;
    padding-bottom: 0.1em;
    margin: 4px 0 -0.1em;
    font-family: var(--font-display);
    font-size: clamp(42px, 12.5vw, 56px);
    font-weight: 380;
    font-variation-settings: 'opsz' 40;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .ms-head > span {
    display: block;
  }
  .ms-head-cap {
    margin: 10px 0 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(244 240 230 / 0.52);
  }
  .ms-head-cap--sub {
    margin-top: 26px;
  }
  .msheet:is([data-view='servicios'], [data-view='soluciones'], [data-view='sectores'], [data-view='recursos']) .ms-level:not([data-level='root']):not([inert]) .ms-head > span {
    animation: ms-rise 0.8s var(--ease-out-soft) 0.12s both;
  }
  .msheet:is([data-view='servicios'], [data-view='soluciones'], [data-view='sectores'], [data-view='recursos']) .ms-level:not([inert]) :is(.ms-tile, .ms-row, .ms-card, .ms-head-cap, .ms-sub) {
    animation: ms-tile 0.6s var(--ease-out-soft) both;
    animation-delay: calc(0.18s + var(--i, 0) * 0.04s);
  }
  @keyframes ms-tile {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }

  /* Services: one tile per service, each with its own animated drawing. */
  .ms-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
  .ms-tile > a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 12px 12px 14px;
    border-radius: 18px;
    background:
      radial-gradient(130% 75% at 50% 0%, color-mix(in srgb, var(--tint) 20%, transparent), transparent 75%),
      #1a1736;
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.1);
    transition:
      transform 0.35s var(--ease-spring),
      box-shadow 0.25s;
  }
  .ms-tile > a:active {
    transform: scale(0.97);
  }
  .ms-tile > a[aria-current] {
    box-shadow:
      inset 0 0 0 1.5px var(--color-accent),
      0 0 24px -8px rgb(255 90 31 / 0.8);
  }
  .ms-art {
    display: block;
    height: 86px;
    margin: 2px 0 12px;
    --glyph-paper: #1d1a3c;
  }
  .ms-art :global(.glyph) {
    color: var(--color-paper);
  }
  .ms-tile-name {
    display: block;
    font-size: 15px;
    font-weight: 580;
    line-height: 1.2;
  }
  .ms-tile-desc {
    display: -webkit-box;
    margin-top: 4px;
    overflow: hidden;
    font-size: 12.5px;
    line-height: 1.38;
    color: rgb(244 240 230 / 0.58);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .ms-tile--feature {
    grid-column: 1 / -1;
  }
  .ms-tile--feature > a {
    display: grid;
    grid-template-columns: 1fr 42%;
    align-items: end;
    gap: 12px;
    min-height: 176px;
    padding: 16px;
    background:
      radial-gradient(90% 120% at 100% 0%, rgb(255 90 31 / 0.22), transparent 70%),
      #1a1736;
  }
  .ms-tile--feature .ms-art {
    order: 2;
    align-self: center;
    height: 112px;
    margin: 0;
  }
  .ms-tile--feature .ms-tile-name {
    font-family: var(--font-display);
    font-size: 25px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .ms-tile--feature .ms-tile-desc {
    -webkit-line-clamp: 4;
    margin-top: 8px;
  }
  .ms-flag {
    display: inline-block;
    margin-bottom: 12px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--color-accent);
    color: #1a0a03;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ms-sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 10px;
    padding: 14px 16px;
    border-radius: 16px;
    color: var(--color-paper);
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.2);
  }
  .ms-sub:active {
    background: rgb(244 240 230 / 0.08);
  }
  .ms-sub-name {
    display: block;
    font-size: 15.5px;
    font-weight: 560;
  }
  .ms-sub-desc {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    color: rgb(244 240 230 / 0.6);
  }
  .ms-sub :global(svg) {
    flex: none;
    color: var(--color-accent);
  }
  .ms-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 15px;
    font-weight: 560;
    color: var(--color-accent);
  }

  /* Solutions and resources: rows, then a card. */
  .ms-rows {
    display: grid;
  }
  .ms-row + .ms-row {
    border-top: 1px solid rgb(244 240 230 / 0.08);
  }
  .ms-row > a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 4px;
    border-radius: 14px;
    transition: background-color 0.2s;
  }
  .ms-row > a:active {
    background: rgb(244 240 230 / 0.06);
  }
  .ms-row-ico {
    display: grid;
    flex: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: #221e46;
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.1);
  }
  .ms-row-name {
    display: block;
    font-size: 16.5px;
    font-weight: 560;
    line-height: 1.25;
  }
  .ms-row-desc {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.4;
    color: rgb(244 240 230 / 0.58);
  }
  .ms-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 20px;
    padding: 20px;
    border-radius: 22px;
    color: var(--color-ink);
  }
  .ms-card-text {
    margin-top: 28px;
    font-family: var(--font-display);
    font-size: 25px;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .ms-card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 560;
  }

  .msheet :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  @media (min-width: 1024px) {
    .msheet {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]')!;
  const mega = header.querySelector<HTMLElement>('[data-mega]')!;
  const surface = mega.querySelector<HTMLElement>('[data-surface]')!;
  const scrim = document.querySelector<HTMLElement>('[data-scrim]')!;
  const triggers = [...header.querySelectorAll<HTMLButtonElement>('[data-trigger]')];
  const panels = new Map([...mega.querySelectorAll<HTMLElement>('[data-panel]')].map((p) => [p.dataset.panel!, p]));
  const order = triggers.map((t) => t.dataset.trigger!);
  const fine = matchMedia('(hover: hover) and (pointer: fine)');

  let current: string | null = null;
  let closeTimer = 0;
  let openTimer = 0;

  const onScroll = () => header.toggleAttribute('data-scrolled', scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  function size(panel: HTMLElement) {
    const box = panel.firstElementChild as HTMLElement;
    surface.style.width = `${box.offsetWidth}px`;
    surface.style.height = `${box.offsetHeight}px`;
  }

  function open(id: string) {
    clearTimeout(closeTimer);
    if (current === id) return;
    const panel = panels.get(id);
    if (!panel) return;
    const prev = current;
    current = id;
    triggers.forEach((t) => t.setAttribute('aria-expanded', String(t.dataset.trigger === id)));
    mega.hidden = false;
    scrim.hidden = false;
    header.setAttribute('data-open', '');
    panels.forEach((p, key) => {
      if (key === id) return;
      if (p.hasAttribute('data-active')) {
        p.dataset.from = order.indexOf(key) < order.indexOf(id) ? 'left' : 'right';
      }
      p.removeAttribute('data-active');
    });
    if (prev) panel.dataset.from = order.indexOf(prev) < order.indexOf(id) ? 'right' : 'left';
    else delete panel.dataset.from;
    // Centre the surface under its trigger, kept inside the viewport.
    size(panel);
    requestAnimationFrame(() => {
      panel.setAttribute('data-active', '');
      mega.setAttribute('data-shown', '');
      scrim.setAttribute('data-shown', '');
    });
  }

  function close() {
    if (!current) return;
    current = null;
    triggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
    mega.removeAttribute('data-shown');
    scrim.removeAttribute('data-shown');
    header.removeAttribute('data-open');
    panels.forEach((p) => p.removeAttribute('data-active'));
    setTimeout(() => {
      if (current) return;
      mega.hidden = true;
      scrim.hidden = true;
    }, 300);
  }

  triggers.forEach((trigger) => {
    const id = trigger.dataset.trigger!;
    trigger.addEventListener('click', () => (current === id ? close() : open(id)));
    trigger.addEventListener('pointerenter', () => {
      if (!fine.matches) return;
      clearTimeout(openTimer);
      openTimer = window.setTimeout(() => open(id), current ? 0 : 90);
    });
    trigger.addEventListener('pointerleave', () => clearTimeout(openTimer));
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        open(id);
        panels.get(id)?.querySelector<HTMLElement>('a')?.focus();
      }
    });
  });

  header.addEventListener('pointerleave', () => {
    if (!fine.matches) return;
    clearTimeout(openTimer);
    closeTimer = window.setTimeout(close, 220);
  });
  header.addEventListener('pointerenter', () => clearTimeout(closeTimer));
  scrim.addEventListener('click', close);
  header.querySelectorAll<HTMLElement>('nav a:not([data-trigger])').forEach((link) =>
    link.addEventListener('pointerenter', () => fine.matches && close()),
  );
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const was = current;
    close();
    if (was) triggers.find((t) => t.dataset.trigger === was)?.focus();
    closeSheet();
  });
  mega.addEventListener('focusout', (event) => {
    const next = event.relatedTarget as Node | null;
    if (next && !header.contains(next)) close();
  });
  addEventListener('resize', () => current && size(panels.get(current)!));

  // Phone menu
  const burger = header.querySelector<HTMLButtonElement>('[data-burger]')!;
  const sheet = document.querySelector<HTMLElement>('[data-sheet]')!;
  const closeButton = sheet.querySelector<HTMLButtonElement>('[data-close]')!;
  const levels = [...sheet.querySelectorAll<HTMLElement>('[data-level]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const wide = matchMedia('(min-width: 1024px)');
  let sheetOpen = false;
  let sheetTimer = 0;

  // Everything outside the menu goes inert while it is open.
  const outside = () => [...document.body.children].filter((el): el is HTMLElement => el !== sheet && el instanceof HTMLElement && el.tagName !== 'SCRIPT');

  function show(view: string) {
    sheet.dataset.view = view;
    levels.forEach((level) => {
      const on = level.dataset.level === view;
      level.inert = !on;
      if (on && view !== 'root') level.scrollTop = 0;
    });
    sheet.querySelectorAll<HTMLElement>('[data-go]').forEach((button) => button.setAttribute('aria-expanded', String(button.dataset.go === view)));
  }

  function openSheet() {
    if (sheetOpen) return;
    sheetOpen = true;
    clearTimeout(sheetTimer);
    // The iris opens from the centre of the menu button and reaches the farthest corner.
    const r = burger.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    sheet.style.setProperty('--ix', `${x}px`);
    sheet.style.setProperty('--iy', `${y}px`);
    sheet.style.setProperty('--ir', `${Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)) + 8}px`);
    show('root');
    sheet.removeAttribute('data-closing');
    sheet.hidden = false;
    void sheet.offsetWidth;
    sheet.setAttribute('data-open', '');
    burger.setAttribute('aria-expanded', 'true');
    outside().forEach((el) => (el.inert = true));
    document.documentElement.style.overflow = 'hidden';
    closeButton.focus({ preventScroll: true });
  }

  function closeSheet(instant = false) {
    if (!sheetOpen) return;
    sheetOpen = false;
    burger.setAttribute('aria-expanded', 'false');
    outside().forEach((el) => (el.inert = false));
    document.documentElement.style.overflow = '';
    const finish = () => {
      sheet.hidden = true;
      sheet.removeAttribute('data-open');
      sheet.removeAttribute('data-closing');
    };
    clearTimeout(sheetTimer);
    if (instant || reduce.matches) finish();
    else {
      sheet.setAttribute('data-closing', '');
      sheetTimer = window.setTimeout(finish, 520);
    }
    if (!instant) burger.focus({ preventScroll: true });
  }

  burger.addEventListener('click', openSheet);
  closeButton.addEventListener('click', () => closeSheet());
  sheet.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((button) =>
    button.addEventListener('click', () => {
      show(button.dataset.go!);
      sheet.querySelector<HTMLElement>(`[data-level="${button.dataset.go}"] [data-back]`)?.focus({ preventScroll: true });
    }),
  );
  sheet.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((button) =>
    button.addEventListener('click', () => {
      const from = sheet.dataset.view;
      show('root');
      sheet.querySelector<HTMLElement>(`[data-go="${from}"]`)?.focus({ preventScroll: true });
    }),
  );
  // A link to another page leaves the menu up while the next page loads (the view
  // transition fades it out); a link within this page closes it first so it can scroll.
  sheet.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) =>
    link.addEventListener('click', () => {
      if (link.target === '_blank' || link.protocol === 'mailto:') return;
      if (link.pathname === location.pathname) closeSheet(true);
    }),
  );
  levels.forEach((level) => level.addEventListener('scroll', () => level.toggleAttribute('data-scrolled', level.scrollTop > 4), { passive: true }));
  wide.addEventListener('change', () => wide.matches && closeSheet(true));
  addEventListener('pageshow', (event) => event.persisted && closeSheet(true));
</script>
