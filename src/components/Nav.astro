  }
  .mega-scrim[data-shown] {
    opacity: 1;
  }

  /* Scoped .nav-trigger sets display, which beat Tailwind's `hidden`: say it here. */
  .nav-contact {
    display: none;
  }
  @media (min-width: 768px) {
    .nav-contact {
      display: inline-flex;
    }
  }
  /* With five menus the bar is full on small laptops; the button beside it goes to the same page. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .nav-contact {
      display: none;
    }
  }
  .nav-burger {
    display: inline-grid;
