---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { servicesFor, serviceHref } from '../data/services';
import { sectorsFor } from '../data/sectors';
import { askAiFor, site } from '../data/site';
import { langOf, pathTo, sectorHref } from '../i18n';

const lang = langOf(Astro.url);
const services = servicesFor(lang);
const askAi = askAiFor(lang);
const T = {
  es: {
    blurb: 'Estudio de ingeniería y diseño. Automatizaciones con IA, software a medida y webs que se recuerdan. El código y las cuentas, siempre a vuestro nombre.',
    ask: 'Pregunta a una IA por Veodar',
    nav: 'Pie de página',
    cols: ['Ingeniería', 'Estudio', 'Soluciones', 'Sectores', 'Veodar'],
    areas: ['TI', 'Seguridad', 'Finanzas', 'Personas', 'RevOps', 'Legal'],
    more: ['Todos los servicios', 'Cómo trabajamos', 'Precios', 'Preguntas frecuentes', 'Contacto'],
    allSectors: 'Todos los sectores',
    made: 'Hecho a medida, como todo lo demás.',
    tech: 'Astro · 0 cookies de seguimiento · AA',
  },
  en: {
    blurb: 'Engineering and design studio. AI automation, custom software and websites people remember. Code and accounts, always in your name.',
    ask: 'Ask an AI about Veodar',
    nav: 'Footer',
    cols: ['Engineering', 'Studio', 'Solutions', 'Industries', 'Veodar'],
    areas: ['IT', 'Security', 'Finance', 'People', 'RevOps', 'Legal'],
    more: ['All services', 'How we work', 'Pricing', 'FAQ', 'Contact'],
    allSectors: 'All industries',
    made: 'Custom-made, like everything else.',
    tech: 'Astro · 0 tracking cookies · AA',
  },
}[lang];

const columns = [
  {
    title: T.cols[0],
    links: services.filter((s) => s.group === 'ingenieria').map((s) => ({ label: s.name, href: serviceHref(s.slug, lang) })),
  },
  {
    title: T.cols[1],
    links: services.filter((s) => s.group === 'estudio').map((s) => ({ label: s.name, href: serviceHref(s.slug, lang) })),
  },
  {
    title: T.cols[2],
    links: ['ti', 'seguridad', 'finanzas', 'personas', 'revops', 'legal'].map((id, i) => ({ label: T.areas[i], href: pathTo('soluciones', lang, id) })),
  },
  {
    title: T.cols[3],
    links: [
      ...sectorsFor(lang).map((sector) => ({ label: sector.name, href: sectorHref(sector.id, lang) })),
      { label: T.allSectors, href: pathTo('sectores', lang) },
    ],
  },
  {
    title: T.cols[4],
    links: [
      pathTo('servicios', lang),
      pathTo('home', lang, 'proceso'),
      pathTo('precios', lang),
      pathTo('home', lang, 'preguntas'),
      pathTo('contacto', lang),
    ].map((href, i) => ({ label: T.more[i], href })),
  },
];
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-night text-paper" data-dark data-spine="0.361">
  <div class="wrap pt-20 pb-10 md:pt-28">
    <div class="grid gap-14 lg:grid-cols-[1.1fr_2fr]">
      <div>
        <Logo inverted class="text-paper" />
        <p class="mt-6 max-w-[34ch] text-[15px] leading-relaxed text-paper/70">
          {T.blurb}
        </p>
        <a href={`mailto:${site.email}`} class="mt-6 inline-flex items-center gap-2 font-display text-[28px] tracking-[-0.03em] text-paper hover:text-accent">
          {site.email} <Icon name="arrow" size={22} />
        </a>
        <div class="mt-8">
          <p class="font-mono text-[11.5px] tracking-[0.12em] text-paper/50 uppercase">{T.ask}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              askAi.map((ai) => (
                <a href={ai.href} target="_blank" rel="noopener" class="rounded-full px-3 py-1.5 text-[13px] text-paper/80 ring-1 ring-paper/20 transition hover:bg-paper hover:text-ink">
                  {ai.name}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <nav class="grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-3 xl:grid-cols-5" aria-label={T.nav}>
        {
          columns.map((column) => (
            <div>
              <p class="font-mono text-[11.5px] tracking-[0.12em] text-paper/50 uppercase">{column.title}</p>
              <ul class="mt-4 grid gap-2.5">
                {column.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-[14.5px] text-paper/80 transition hover:text-paper">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <p class="footer-word" aria-hidden="true">veodar</p>

    <div class="flex flex-col gap-3 border-t border-paper/15 pt-6 text-[13px] text-paper/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Veodar. {T.made}</p>
      <div class="flex items-center gap-5">
        <p class="font-mono text-[12px]">{T.tech}</p>
        <div class="footer-lang"><LangSwitch variant="bar" /></div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-lang :global(.ls) {
    display: inline-grid;
    color: var(--color-paper);
    --ls-on: var(--color-night);
  }
  .footer-word {
    margin: 4.5rem 0 1.5rem;
    font-family: var(--font-display);
    font-weight: 380;
    font-size: clamp(5rem, 25.5vw, 23rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    background: linear-gradient(180deg, rgb(244 240 230 / 0.16) 10%, rgb(244 240 230 / 0.02) 92%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    white-space: nowrap;
  }
</style>
