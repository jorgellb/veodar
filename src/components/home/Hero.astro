---
import Icon from '../Icon.astro';
import Plant from '../iso/Plant.astro';

const stack = [
  'Claude',
  'GPT',
  'Gemini',
  'MCP',
  'LangGraph',
  'n8n',
  'Astro',
  'Next.js',
  'React 19',
  'TypeScript',
  'Expo',
  'SwiftUI',
  'Jetpack Compose',
  'Tauri 2',
  'Rust',
  'Three.js',
  'WebGPU',
  'GSAP',
  'Remotion',
  'Supabase',
  'PostgreSQL',
  'Cloudflare',
  'Vercel',
];

// Hubs: what the client already runs (in) and what we build on top (out).
const hubsIn = [
  { label: 'Correo', icon: 'mail', x: 34, y: 0 },
  { label: 'ERP', icon: 'layers', x: 126, y: 86 },
  { label: 'CRM', icon: 'sliders', x: 0, y: 176 },
  { label: 'Documentos', icon: 'layout', x: 56, y: 270 },
];
const hubsOut = [
  { label: 'Agentes IA', icon: 'spark', x: 62, y: 0 },
  { label: 'Web', icon: 'browser', x: 0, y: 86 },
  { label: 'App móvil', icon: 'phone', x: 100, y: 176 },
  { label: 'Escritorio', icon: 'desktop', x: 18, y: 270 },
];
---

<section class="hero" data-dark data-spine="0.5" aria-labelledby="hero-title">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-hubs hero-hubs--in" aria-hidden="true">
    <p class="hub-label">Tus sistemas</p>
    {
      hubsIn.map((hub, index) => (
        <span class="hub" data-hub="in" data-reveal style={`left:${hub.x}px;top:${hub.y + 34}px;--d:${400 + index * 110}ms`}>
          <i class="hub-ico">
            <Icon name={hub.icon} size={16} />
          </i>
          {hub.label}
        </span>
      ))
    }
  </div>
  <div class="hero-hubs hero-hubs--out" aria-hidden="true">
    <p class="hub-label hub-label--right">Lo que construimos</p>
    {
      hubsOut.map((hub, index) => (
        <span class="hub" data-hub="out" data-reveal style={`left:${hub.x}px;top:${hub.y + 34}px;--d:${460 + index * 110}ms`}>
          <i class="hub-ico hub-ico--out">
            <Icon name={hub.icon} size={16} />
          </i>
          {hub.label}
        </span>
      ))
    }
  </div>

  <div class="wrap pt-8 text-center md:pt-10">
    <a href="/servicios/automatizaciones-ia/" class="hero-pill" data-reveal>
      <span class="hero-pill-tag">Nuevo</span>
      Agentes con MCP conectados a tu ERP y tu CRM
      <Icon name="arrow" size={15} />
    </a>

    <h1 id="hero-title" class="display h-hero mx-auto mt-7 max-w-[13ch] text-paper" data-reveal style="--d:80ms">
      Ponemos la IA a <em>trabajar</em>. Y le construimos el taller.
    </h1>

    <p class="lead mx-auto mt-7 max-w-[52ch] !text-paper/75" data-reveal style="--d:160ms">
      Automatizaciones con IA, desarrollo web y apps móviles y de escritorio con la tecnología más actual. Diseñado y construido por el mismo equipo, con el código y las cuentas a nombre de tu empresa.
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3" data-reveal style="--d:240ms">
      <a href="/contacto/" class="btn btn-accent">Cuéntanos tu proyecto <Icon name="arrow" size={17} class="arrow" /></a>
      <a href="#servicios" class="btn btn-ghost-light">Ver servicios</a>
    </div>
  </div>

  <div class="wrap mt-20 md:mt-[92px]" data-reveal style="--d:320ms">
    <div class="hero-machine relative">
      <Plant />
      <span class="float-chip hidden md:inline-flex" style="top:16%;left:-14px"><i class="dot"></i>La IA propone</span>
      <span class="float-chip hidden md:inline-flex" style="top:44%;right:-14px"><i class="dot dot--ink"></i>Una persona confirma</span>
      <span class="float-chip hidden lg:inline-flex" style="bottom:20%;left:-14px"><Icon name="key" size={14} />Código a tu nombre</span>
    </div>

    <dl class="hero-stats" data-stats>
      <div class="hero-stats-live">
        <i class="live-dot"></i>
        <span>En vivo · lo que ha hecho esta máquina desde que abriste la página</span>
      </div>
      <div>
        <dd data-stat="done">0</dd>
        <dt>documentos clasificados</dt>
      </div>
      <div>
        <dd data-stat="auto">0</dd>
        <dt>archivados solos</dt>
      </div>
      <div>
        <dd data-stat="review">0</dd>
        <dt>a revisión humana</dt>
      </div>
      <div>
        <dd data-stat="conf">—</dd>
        <dt>confianza media</dt>
      </div>
    </dl>
  </div>

  <div class="hero-marquee relative z-[1] mt-14 py-5 md:mt-20" aria-label="Tecnologías con las que trabajamos">
    <div class="marquee" role="presentation">
      <ul class="marquee-track">
        {[...stack, ...stack].map((item, index) => <li aria-hidden={index >= stack.length ? 'true' : undefined}>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: -68px;
    padding-top: 68px;
    background:
      radial-gradient(900px 520px at 50% 64%, rgb(255 90 31 / 0.2), transparent 70%),
      radial-gradient(700px 500px at 12% 8%, rgb(98 76 201 / 0.22), transparent 70%),
      radial-gradient(700px 500px at 90% 14%, rgb(46 110 201 / 0.16), transparent 70%),
      var(--color-night);
    color: var(--color-paper);
    overflow-x: clip;
  }
  .hero :global(.display em) {
    color: var(--color-accent);
  }
  .hero-glow {
    display: none;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 14px 5px 5px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-paper);
    background: rgb(244 240 230 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.16);
    backdrop-filter: blur(6px);
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .hero-pill:hover {
    background: rgb(244 240 230 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.4);
  }
  .hero-pill-tag {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--color-accent);
    color: #1a0a03;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  :global(.btn-ghost-light) {
    color: var(--color-paper);
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.3);
  }
  :global(.btn-ghost-light:hover) {
    background: rgb(244 240 230 / 0.1);
    box-shadow: inset 0 0 0 1px var(--color-paper);
  }

  /* Hubs: absolutely placed columns either side of the headline (wide screens). */
  .hero-hubs {
    display: none;
    position: absolute;
    top: 150px;
    z-index: 1;
    width: 230px;
    height: 380px;
  }
  @media (min-width: 1280px) {
    .hero-hubs {
      display: block;
    }
  }
  .hero-hubs--in {
    left: max(20px, calc(50% - 690px));
  }
  .hero-hubs--out {
    right: max(20px, calc(50% - 690px));
  }
  .hub-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(244 240 230 / 0.5);
  }
  .hub-label--right {
    text-align: right;
  }
  .hub {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 14px 7px 7px;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 540;
    white-space: nowrap;
    color: var(--color-paper);
    background: #1c1938;
    box-shadow:
      inset 0 0 0 1px rgb(244 240 230 / 0.14),
      inset 0 1px 0 rgb(244 240 230 / 0.1),
      0 14px 30px -14px rgb(0 0 0 / 0.7);
  }
  .hub::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--color-night);
    box-shadow: inset 0 0 0 1.5px var(--color-accent);
  }
  .hub-ico {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: rgb(244 240 230 / 0.1);
  }
  .hub-ico--out {
    background: var(--color-accent);
    color: #1a0a03;
  }
  .hero-machine :global(.veo-plate) {
    box-shadow:
      0 0 0 1px rgb(244 240 230 / 0.14),
      0 60px 140px -40px rgb(255 90 31 / 0.55),
      0 30px 60px -30px rgb(0 0 0 / 0.8);
  }
  .float-chip {
    position: absolute;
    z-index: 2;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 999px;
    background: var(--color-card);
    color: var(--color-ink);
    font-size: 13.5px;
    font-weight: 560;
    box-shadow:
      inset 0 0 0 1px var(--color-line),
      0 14px 30px -14px rgb(0 0 0 / 0.6);
    animation: bob 6s ease-in-out infinite;
  }
  .float-chip:nth-of-type(2) {
    animation-delay: -2s;
  }
  .float-chip:nth-of-type(3) {
    animation-delay: -4s;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px rgb(255 90 31 / 0.18);
  }
  .dot--ink {
    background: var(--color-ink);
    box-shadow: 0 0 0 4px rgb(22 20 44 / 0.12);
  }
  @keyframes bob {
    50% {
      transform: translateY(-7px);
    }
  }

  /* Live counters fed by the machine above. */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin-top: 18px;
    border-radius: 20px;
    overflow: hidden;
    background: rgb(244 240 230 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.12);
  }
  .hero-stats > div {
    padding: 18px 20px;
    background: #171431;
  }
  .hero-stats-live {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(244 240 230 / 0.6);
  }
  @media (min-width: 900px) {
    .hero-stats {
      grid-template-columns: 1.5fr repeat(4, 1fr);
    }
    .hero-stats-live {
      grid-column: auto;
      align-items: flex-start;
      line-height: 1.5;
    }
  }
  .live-dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 0.3em;
    border-radius: 50%;
    background: var(--color-accent);
    animation: live 1.6s ease-out infinite;
  }
  @keyframes live {
    0% {
      box-shadow: 0 0 0 0 rgb(255 90 31 / 0.6);
    }
    100% {
      box-shadow: 0 0 0 10px rgb(255 90 31 / 0);
    }
  }
  .hero-stats dd {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-paper);
  }
  .hero-stats dd[data-bump] {
    animation: bump 0.6s var(--ease-out-soft);
  }
  @keyframes bump {
    0% {
      color: var(--color-accent);
      transform: translateY(6px);
    }
  }
  .hero-stats dt {
    margin-top: 6px;
    font-size: 13.5px;
    color: rgb(244 240 230 / 0.6);
  }

  .hero-marquee {
    border-top: 1px solid rgb(244 240 230 / 0.12);
  }
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: 3rem;
    animation: marquee 48s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .marquee-track li {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.02em;
    color: rgb(244 240 230 / 0.72);
    white-space: nowrap;
  }
  .marquee-track li::before {
    content: '◆';
    margin-right: 3rem;
    font-size: 8px;
    vertical-align: 3px;
    color: var(--color-accent);
  }
</style>

<script>
  // Counters are fed by the figure itself: one event per document it files.
  const stats = document.querySelector<HTMLElement>('[data-stats]');
  if (stats) {
    const cell = (name: string) => stats.querySelector<HTMLElement>(`[data-stat="${name}"]`)!;
    let done = 0;
    let review = 0;
    let sum = 0;
    const set = (el: HTMLElement, text: string) => {
      if (el.textContent === text) return;
      el.textContent = text;
      el.removeAttribute('data-bump');
      void el.offsetWidth;
      el.setAttribute('data-bump', '');
    };
    document.addEventListener('plant:filed', (event) => {
      const detail = (event as CustomEvent<{ review: boolean; conf: number }>).detail;
      done += 1;
      if (detail.review) review += 1;
      sum += detail.conf;
      set(cell('done'), String(done));
      set(cell('auto'), String(done - review));
      set(cell('review'), String(review));
      set(cell('conf'), (sum / done).toFixed(2).replace('.', ','));
    });
  }
</script>
