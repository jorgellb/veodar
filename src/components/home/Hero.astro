---
import Icon from '../Icon.astro';
import Nexus from '../iso/Nexus.astro';

const stack = [
  'Claude',
  'GPT',
  'Gemini',
  'MCP',
  'LangGraph',
  'n8n',
  'Astro',
  'Next.js',
  'React 19',
  'TypeScript',
  'Expo',
  'SwiftUI',
  'Jetpack Compose',
  'Tauri 2',
  'Rust',
  'Three.js',
  'WebGPU',
  'GSAP',
  'Remotion',
  'Supabase',
  'PostgreSQL',
  'Cloudflare',
  'Vercel',
];

// Hubs: what the client already runs (in) and what we build on top (out).
// Their horizontal order matters: from the window edge inward it is the order of
// the sockets on each island's pier in the scene below (iso/fig-nexus.mjs), which
// is what keeps the fibres from crossing.
const hubsIn = [
  { id: 'correo', label: 'Correo', icon: 'mail', x: 34, y: 0 },
  { id: 'erp', label: 'ERP', icon: 'layers', x: 126, y: 86 },
  { id: 'crm', label: 'CRM', icon: 'sliders', x: 0, y: 176 },
  { id: 'documentos', label: 'Documentos', icon: 'layout', x: 56, y: 270 },
];
const hubsOut = [
  { id: 'agentes', label: 'Agentes IA', icon: 'spark', x: 100, y: 0 },
  { id: 'web', label: 'Web', icon: 'browser', x: 0, y: 86 },
  { id: 'movil', label: 'App móvil', icon: 'phone', x: 62, y: 176 },
  { id: 'escritorio', label: 'Escritorio', icon: 'desktop', x: 18, y: 270 },
];
---

<section class="hero" data-dark data-spine="0.5" aria-labelledby="hero-title">
  <div class="hero-hubs hero-hubs--in">
    <p class="hub-label">Tus sistemas</p>
    {
      hubsIn.map((hub, index) => (
        <button type="button" class="hub" data-hub="in" data-id={hub.id} data-reveal aria-label={`Ver el recorrido de ${hub.label}`} style={`left:${hub.x}px;top:${hub.y + 34}px;--d:${400 + index * 110}ms`}>
          <i class="hub-ico">
            <Icon name={hub.icon} size={16} />
          </i>
          {hub.label}
        </button>
      ))
    }
  </div>
  <div class="hero-hubs hero-hubs--out">
    <p class="hub-label hub-label--right">Lo que construimos</p>
    {
      hubsOut.map((hub, index) => (
        <button type="button" class="hub" data-hub="out" data-id={hub.id} data-reveal aria-label={`Ver el recorrido hasta ${hub.label}`} style={`left:${hub.x}px;top:${hub.y + 34}px;--d:${460 + index * 110}ms`}>
          <i class="hub-ico hub-ico--out">
            <Icon name={hub.icon} size={16} />
          </i>
          {hub.label}
        </button>
      ))
    }
  </div>

  <div class="wrap pt-8 text-center md:pt-10">
    <a href="/servicios/automatizaciones-ia/" class="hero-pill" data-reveal>
      <span class="hero-pill-tag">Nuevo</span>
      <span class="hero-pill-text">
        <span class="hero-pill-long">Agentes con MCP conectados a tu ERP y tu CRM</span>
        <span class="hero-pill-short">Agentes con MCP en tu ERP y CRM</span>
      </span>
      <Icon name="arrow" size={15} class="hero-pill-arrow" />
    </a>

    <h1 id="hero-title" class="display h-hero mx-auto mt-7 max-w-[13ch] text-paper" data-reveal style="--d:80ms">
      Ponemos la IA a <em>trabajar</em>. Y le construimos el taller.
    </h1>

    <p class="lead mx-auto mt-7 max-w-[52ch] !text-paper/75" data-reveal style="--d:160ms">
      Automatizaciones con IA, desarrollo web y apps móviles y de escritorio con la tecnología más actual. Diseñado y construido por el mismo equipo, con el código y las cuentas a nombre de tu empresa.
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3" data-reveal style="--d:240ms">
      <a href="/contacto/" class="btn btn-accent">Cuéntanos tu proyecto <Icon name="arrow" size={17} class="arrow" /></a>
      <a href="#servicios" class="btn btn-ghost-light">Ver servicios</a>
    </div>
  </div>

  <div class="wrap mt-6 md:mt-3" data-reveal style="--d:320ms">
    <Nexus />

    <div class="hero-log" data-log>
      <p class="hero-log-live"><i class="live-dot"></i>En vivo</p>
      <p class="hero-log-line">
        <strong data-log-route>El taller, en marcha</strong>
        <span data-log-did>Cada tarea sale de un sistema, pasa por la IA y llega a un producto.</span>
      </p>
      <p class="hero-log-count">
        <span><b data-log-done>0</b> <i data-log-done-label>tareas resueltas</i></span>
        <span><b data-log-reviewed>0</b> <i data-log-reviewed-label>confirmadas por una persona</i></span>
      </p>
    </div>
  </div>

  <div class="hero-marquee relative z-[1] mt-14 py-5 md:mt-16" aria-label="Tecnologías con las que trabajamos">
    <div class="marquee" role="presentation">
      <ul class="marquee-track">
        {[...stack, ...stack].map((item, index) => <li aria-hidden={index >= stack.length ? 'true' : undefined}>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    margin-top: -68px;
    padding-top: 68px;
    background:
      radial-gradient(900px 480px at 50% 72%, rgb(255 90 31 / 0.17), transparent 70%),
      radial-gradient(700px 500px at 12% 8%, rgb(98 76 201 / 0.22), transparent 70%),
      radial-gradient(700px 500px at 90% 14%, rgb(46 110 201 / 0.16), transparent 70%),
      var(--color-night);
    color: var(--color-paper);
    overflow-x: clip;
  }
  .hero :global(.display em) {
    color: var(--color-accent);
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 14px 5px 5px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-paper);
    background: rgb(244 240 230 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.16);
    backdrop-filter: blur(6px);
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .hero-pill:hover {
    background: rgb(244 240 230 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.4);
  }
  /* One line at every width: phones get a shorter wording, and anything that still
     does not fit is cut with an ellipsis instead of wrapping the pill into a block. */
  .hero-pill {
    max-width: 100%;
  }
  .hero-pill-text {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .hero-pill-short {
    display: none;
  }
  .hero-pill :global(.hero-pill-arrow) {
    flex: none;
  }
  @media (max-width: 560px) {
    .hero-pill {
      gap: 8px;
      padding-right: 12px;
      font-size: 13.5px;
    }
    .hero-pill-long {
      display: none;
    }
    .hero-pill-short {
      display: inline;
    }
  }
  @media (max-width: 380px) {
    .hero-pill {
      gap: 7px;
      font-size: 13px;
    }
    .hero-pill-tag {
      padding: 3px 7px;
      font-size: 10px;
    }
  }
  @media (max-width: 350px) {
    .hero-pill {
      gap: 6px;
      padding-right: 11px;
      font-size: 12px;
    }
    .hero-pill :global(.hero-pill-arrow) {
      display: none;
    }
  }
  .hero-pill-tag {
    flex: none;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--color-accent);
    color: #1a0a03;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  :global(.btn-ghost-light) {
    color: var(--color-paper);
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.3);
  }
  :global(.btn-ghost-light:hover) {
    background: rgb(244 240 230 / 0.1);
    box-shadow: inset 0 0 0 1px var(--color-paper);
  }

  /* Hubs: absolutely placed columns either side of the headline (wide screens). */
  .hero-hubs {
    display: none;
    position: absolute;
    top: 150px;
    z-index: 1;
    width: 230px;
    height: 380px;
  }
  @media (min-width: 1280px) {
    .hero-hubs {
      display: block;
    }
  }
  .hero-hubs--in {
    left: max(20px, calc(50% - 690px));
  }
  .hero-hubs--out {
    right: max(20px, calc(50% - 698px));
  }
  .hub-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(244 240 230 / 0.5);
  }
  .hub-label--right {
    text-align: right;
  }
  .hub {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 14px 7px 7px;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 540;
    white-space: nowrap;
    color: var(--color-paper);
    background: #1c1938;
    cursor: pointer;
    box-shadow:
      inset 0 0 0 1px rgb(244 240 230 / 0.14),
      inset 0 1px 0 rgb(244 240 230 / 0.1),
      0 14px 30px -14px rgb(0 0 0 / 0.7);
    transition:
      opacity 0.9s var(--ease-out-soft),
      transform 0.9s var(--ease-out-soft),
      box-shadow 0.35s,
      background-color 0.35s,
      translate 0.35s var(--ease-spring);
    transition-delay: var(--d, 0ms), var(--d, 0ms), 0s, 0s, 0s;
  }
  .hub:hover {
    translate: 0 -2px;
    background: #24204a;
  }
  .hub[data-active] {
    background: #2a2046;
    box-shadow:
      inset 0 0 0 1px rgb(255 90 31 / 0.85),
      0 0 28px -4px rgb(255 90 31 / 0.7),
      0 14px 30px -14px rgb(0 0 0 / 0.7);
  }
  .hub::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -4px;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 50%;
    background: var(--color-night);
    box-shadow: inset 0 0 0 1.5px var(--color-accent);
  }
  .hub-ico {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: rgb(244 240 230 / 0.1);
  }
  .hub-ico--out {
    background: var(--color-accent);
    color: #1a0a03;
  }

  /* Activity strip: the last route the scene completed and what it has done so far. */
  .hero-log {
    display: grid;
    gap: 10px 28px;
    align-items: center;
    margin-top: 6px;
    padding: 14px 20px;
    border-radius: 18px;
    background: rgb(23 20 49 / 0.78);
    box-shadow: inset 0 0 0 1px rgb(244 240 230 / 0.12);
    backdrop-filter: blur(8px);
  }
  @media (min-width: 900px) {
    .hero-log {
      grid-template-columns: auto 1fr auto;
    }
  }
  .hero-log-live {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(244 240 230 / 0.6);
  }
  .live-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: live 1.6s ease-out infinite;
  }
  @keyframes live {
    0% {
      box-shadow: 0 0 0 0 rgb(255 90 31 / 0.6);
    }
    100% {
      box-shadow: 0 0 0 10px rgb(255 90 31 / 0);
    }
  }
  .hero-log-line {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    align-items: baseline;
    min-width: 0;
  }
  .hero-log-line strong {
    font-family: var(--font-mono);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-paper);
  }
  .hero-log-line span {
    font-size: 14px;
    color: rgb(244 240 230 / 0.66);
  }
  .hero-log-line[data-fresh] strong {
    animation: fresh 0.7s var(--ease-out-soft);
  }
  @keyframes fresh {
    0% {
      color: var(--color-accent);
      transform: translateY(5px);
      opacity: 0.3;
    }
  }
  .hero-log-count {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    font-size: 13.5px;
    color: rgb(244 240 230 / 0.6);
  }
  .hero-log-count i {
    font-style: normal;
  }
  .hero-log-count b {
    margin-right: 5px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--color-paper);
  }

  .hero-marquee {
    border-top: 1px solid rgb(244 240 230 / 0.12);
  }
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    gap: 3rem;
    animation: marquee 48s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .marquee-track li {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.02em;
    color: rgb(244 240 230 / 0.72);
    white-space: nowrap;
  }
  .marquee-track li::before {
    content: '◆';
    margin-right: 3rem;
    font-size: 8px;
    vertical-align: 3px;
    color: var(--color-accent);
  }
</style>

<script>
  // The scene below tells the page what it is doing; the chips and the strip follow it.
  const chips = new Map([...document.querySelectorAll<HTMLElement>('.hub[data-id]')].map((el) => [el.dataset.id!, el]));
  const timers = new Map<string, number>();
  document.addEventListener('nexus:pulse', (event) => {
    const { id, dur } = (event as CustomEvent<{ id: string; dur: number }>).detail;
    const chip = chips.get(id);
    if (!chip) return;
    chip.setAttribute('data-active', '');
    clearTimeout(timers.get(id));
    timers.set(
      id,
      window.setTimeout(() => chip.removeAttribute('data-active'), dur * 1000 + 500),
    );
  });
  chips.forEach((chip, id) => chip.addEventListener('click', () => document.dispatchEvent(new CustomEvent('nexus:request', { detail: { id } }))));

  const log = document.querySelector<HTMLElement>('[data-log]');
  if (log) {
    const line = log.querySelector<HTMLElement>('.hero-log-line')!;
    const set = (sel: string, text: string) => (log.querySelector<HTMLElement>(sel)!.textContent = text);
    document.addEventListener('nexus:done', (event) => {
      const d = (event as CustomEvent<{ route: string; did: string; done: number; reviewed: number }>).detail;
      set('[data-log-route]', d.route);
      set('[data-log-did]', d.did);
      set('[data-log-done]', String(d.done));
      set('[data-log-done-label]', d.done === 1 ? 'tarea resuelta' : 'tareas resueltas');
      set('[data-log-reviewed]', String(d.reviewed));
      set('[data-log-reviewed-label]', d.reviewed === 1 ? 'confirmada por una persona' : 'confirmadas por una persona');
      line.removeAttribute('data-fresh');
      void line.offsetWidth;
      line.setAttribute('data-fresh', '');
    });
  }
</script>
