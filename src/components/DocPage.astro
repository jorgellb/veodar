---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import Plant from './iso/Plant.astro';
import Figure from './iso/Figure.astro';
import ServiceCard from './ServiceCard.astro';
import CrossLinks, { type CrossItem } from './CrossLinks.astro';
import Pager from './Pager.astro';
import type { Block, Faq as FaqItem } from '../data/pages';
import type { Tint } from '../data/services';
import { servicesFor } from '../data/services';
import { breadcrumbLd, faqLd } from '../data/site';
import { langOf, pathTo } from '../i18n';
import { linkify, startLinks } from '../i18n/links';
import { UPDATED } from '../data/updated';

interface Props {
  title: string;
  description: string;
  kicker: string;
  h1: string;
  lead: string;
  blocks: Block[];
  faq: FaqItem[];
  deliverablesTitle: string;
  deliverables: string[];
  related: string[];
  ctaTitle: string;
  ctaText: string;
  ctaHref?: string;
  ctaLabel?: string;
  crumbs: { name: string; path: string }[];
  figure: string;
  sceneTitle?: string;
  sceneCaption?: string;
  stack?: string[];
  /** Label for the stack chips (defaults to "Technologies"). */
  stackLabel?: string;
  /** Stack names that have a page of their own, and where it is. */
  stackHrefs?: Record<string, string>;
  /**
   * Width of the headline in `ch`, when 14 is too close to one of its lines: a headline
   * that fits in two lines by a few pixels takes three while the web fonts load, and the
   * page jumps when they arrive. A narrower box breaks it the same way in both.
   */
  h1Max?: number;
  tint?: Tint;
  extraLd?: Record<string, unknown>[];
  /** schema.org type of the page (WebPage, ContactPage, CollectionPage…). */
  pageType?: string;
  /** ISO date the content last changed (see src/data/updated.ts). */
  updated?: string;
  /** A line per related service, specific to this page (sector pages). */
  relatedNotes?: Record<string, string | undefined>;
  /** Blocks of internal links with context, after the related services. */
  cross?: { id: string; title: string; kicker?: string; items: CrossItem[]; allHref?: string; allLabel?: string; columns?: 2 | 3; compact?: boolean }[];
  /** The page fills the "after-detail" slot: a block under the detail column, beside the page index. */
  afterDetail?: boolean;
  /** Entries of the page index for that block, between what is handed over and the questions. */
  tocExtra?: { id: string; label: string }[];
  /** Previous and next page of the same kind. */
  pager?: { prev: { href: string; label: string }; next: { href: string; label: string }; prevLabel: string; nextLabel: string; ariaLabel: string };
}

const p = Astro.props;
const lang = langOf(Astro.url);
const services = servicesFor(lang);
// Contextual keyword links in the running text (once per target, see src/i18n/links.ts).
startLinks(Astro.url.pathname);
const linked = (text: string) => linkify(text, lang, Astro.url.pathname, 2);
const T = {
  es: {
    crumbs: 'Migas de pan',
    cta: 'Cuéntanos tu proyecto',
    detail: 'Leer el detalle',
    tech: 'Tecnologías',
    onPage: 'En esta página',
    get: 'Qué recibís',
    questions: 'Preguntas',
    deliverables: 'Entregables',
    faqTitle: 'Lo que nos suelen preguntar',
    fits: 'Encaja con',
    all: 'Todos los servicios',
    updated: 'Actualizado',
  },
  en: {
    crumbs: 'Breadcrumb',
    cta: 'Tell us about your project',
    detail: 'Read the details',
    tech: 'Technologies',
    onPage: 'On this page',
    get: 'What you get',
    questions: 'Questions',
    deliverables: 'Deliverables',
    faqTitle: 'What we usually get asked',
    fits: 'Works well with',
    all: 'All services',
    updated: 'Updated',
  },
}[lang];
const updatedIso = p.updated ?? UPDATED.pages;
const updated = new Date(`${updatedIso}T12:00:00Z`).toLocaleDateString(lang === 'en' ? 'en-US' : 'es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
// A page can put something of its own beside the headline (Contacto puts its form);
// the figure then moves under the text on wide screens and after it on phones.
const aside = Astro.slots.has('hero-aside');
const relatedServices = p.related.map((slug) => services.find((s) => s.slug === slug)).filter((s) => s !== undefined);
const tintBg: Record<string, string> = {
  mint: 'bg-mint',
  sky: 'bg-sky',
  butter: 'bg-butter',
  blush: 'bg-blush',
  lilac: 'bg-lilac',
  paper: 'bg-paper-2',
};
const ld = [breadcrumbLd(p.crumbs), faqLd(p.faq), ...(p.extraLd ?? [])];
---

<BaseLayout title={p.title} description={p.description} jsonLd={ld} pageType={p.pageType} updated={updatedIso}>
  <div class="read-progress" aria-hidden="true"></div>
  <section class="pt-8 pb-16 md:pt-12 md:pb-24" data-spine={aside ? '0.4726' : '0.4885'}>
    <div class="wrap">
      <nav aria-label={T.crumbs} class="font-mono text-[12px] tracking-[0.04em] text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          {
            p.crumbs.map((crumb, index) => (
              <li class="flex items-center gap-2">
                {index > 0 && <span aria-hidden="true">/</span>}
                {index < p.crumbs.length - 1 ? (
                  <a href={crumb.path} class="hover:text-ink">
                    {crumb.name}
                  </a>
                ) : (
                  <span aria-current="page" class="text-ink">
                    {crumb.name}
                  </span>
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      <div class:list={['mt-10 grid gap-12 lg:gap-14', aside ? 'hero-aside items-start lg:grid-cols-[1fr_1.12fr]' : 'items-center lg:grid-cols-[1fr_1.05fr]']}>
        <div class="hero-text">
          <p class="eyebrow" data-reveal>{p.kicker}</p>
          <h1 class="display h-xl mt-5 max-w-[14ch]" data-reveal style={`--d:60ms${p.h1Max ? `;max-width:${p.h1Max}ch` : ''}`}>
            {p.h1}
          </h1>
          <p class="lead mt-7 max-w-[56ch]" data-reveal style="--d:120ms" set:html={linkify(p.lead, lang, Astro.url.pathname, 1, false)} />
          {
            !aside && (
              <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--d:180ms">
                <a href={p.ctaHref ?? pathTo('contacto', lang)} class="btn btn-primary">
                  {p.ctaLabel ?? T.cta} <Icon name="arrow" size={17} class="arrow" />
                </a>
                <a href="#detalle" class="btn btn-ghost">
                  {T.detail}
                </a>
              </div>
            )
          }
          {
            p.stack && (
              <div class="mt-10" data-reveal style="--d:240ms">
                {p.stackLabel && <p class="mb-3 font-mono text-[11px] tracking-[0.12em] text-muted uppercase">{p.stackLabel}</p>}
                <ul class="flex flex-wrap gap-1.5" aria-label={p.stackLabel ?? T.tech}>
                  {p.stack.map((tech) =>
                    p.stackHrefs?.[tech] ? (
                      <li>
                        <a href={p.stackHrefs[tech]} class="chip chip-link">
                          {tech}
                        </a>
                      </li>
                    ) : (
                      <li class="chip">{tech}</li>
                    ),
                  )}
                </ul>
              </div>
            )
          }
        </div>
        {
          aside && (
            <div class="hero-form" data-reveal style="--d:120ms">
              <slot name="hero-aside" />
            </div>
          )
        }
        <div class="hero-figure" data-reveal style="--d:140ms">
          {
            p.figure === 'plant' ? (
              <Plant />
            ) : (
              <Figure name={p.figure} fig="Fig. 01" title={p.sceneTitle ?? p.kicker} caption={p.sceneCaption} compact={aside} />
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section id="detalle" class="border-t border-line py-20 md:py-28" data-spine="0.226">
    <div class="wrap grid gap-12 lg:grid-cols-[240px_1fr] lg:gap-20">
      <aside class:list={['hidden lg:block', p.afterDetail && 'lg:row-span-2']}>
        <nav class="sticky top-28" aria-label={T.onPage}>
          <p class="font-mono text-[11.5px] tracking-[0.12em] text-muted uppercase">{T.onPage}</p>
          <ul class="mt-4 grid gap-1 border-l border-line" data-toc>
            {
              p.blocks.map((block) => (
                <li>
                  <a href={`#${block.id}`} class="toc-link">
                    {block.nav ?? block.heading}
                  </a>
                </li>
              ))
            }
            <li><a href="#entregables" class="toc-link">{T.get}</a></li>
            {(p.tocExtra ?? []).map((item) => <li><a href={`#${item.id}`} class="toc-link">{item.label}</a></li>)}
            <li><a href="#preguntas" class="toc-link">{T.questions}</a></li>
          </ul>
        </nav>
      </aside>

      <div class="max-w-[760px]">
        {
          p.blocks.map((block, index) => (
            <article id={block.id} class="doc-block" data-section>
              <p class="font-mono text-[12px] text-accent-ink">{String(index + 1).padStart(2, '0')}</p>
              <h2 class="display h-md mt-3">{block.heading}</h2>
              <div class="prose-v mt-6 text-[17px]">
                {block.paragraphs.map((paragraph) => (
                  <p set:html={linked(paragraph)} />
                ))}
              </div>
            </article>
          ))
        }

        <div id="entregables" class:list={['mt-16 rounded-[28px] p-8 md:p-10', tintBg[p.tint ?? 'paper']]} data-section data-node>
          <p class="eyebrow !text-ink-2">{T.deliverables}</p>
          <h2 class="display h-md mt-4 max-w-[20ch]">{p.deliverablesTitle}</h2>
          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            {
              p.deliverables.map((item) => (
                <li class="flex gap-3 rounded-2xl bg-white/55 p-4 text-[15px] leading-snug shadow-[inset_0_0_0_1px_rgb(22_20_44/0.06)]">
                  <span class="mt-0.5 grid h-6 w-6 flex-none place-items-center rounded-full bg-ink text-paper">
                    <Icon name="check" size={14} />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      {
        p.afterDetail && (
          <div class="min-w-0 lg:col-start-2">
            <slot name="after-detail" />
          </div>
        )
      }
    </div>
  </section>

  <div class="border-t border-line">
    <Faq items={p.faq} title={T.faqTitle} />
    <p class="wrap -mt-14 pb-14 font-mono text-[11.5px] tracking-[0.06em] text-muted md:-mt-20 md:pb-20">
      {T.updated}: <time datetime={updatedIso}>{updated}</time>
    </p>
  </div>

  {
    relatedServices.length > 0 && (
      <section class="border-t border-line py-20 md:py-28" data-spine="0.331" aria-labelledby="related-title">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id="related-title" class="display h-lg">{T.fits}</h2>
            <a href={pathTo('servicios', lang)} class="link-arrow">
              {T.all} <Icon name="arrow" size={16} />
            </a>
          </div>
          <ul class="mt-10 grid gap-4 md:grid-cols-3">
            {relatedServices.map((service) => (
              <li>
                <ServiceCard service={service} note={p.relatedNotes?.[service.slug]} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {(p.cross ?? []).map((block) => <CrossLinks {...block} />)}
  {p.pager && <Pager {...p.pager} />}

  <CtaBand title={p.ctaTitle} text={p.ctaText} href={p.ctaHref} label={p.ctaLabel} />
</BaseLayout>

<style>
  /* With a hero aside: text and figure share the left column, the aside takes the right. */
  @media (min-width: 1024px) {
    .hero-aside {
      grid-template-areas:
        'text form'
        'figure form';
      grid-template-rows: auto 1fr;
    }
    .hero-aside .hero-text {
      grid-area: text;
    }
    .hero-aside .hero-form {
      grid-area: form;
    }
    .hero-aside .hero-figure {
      grid-area: figure;
    }
  }
  .toc-link {
    display: block;
    margin-left: -1px;
    padding: 6px 0 6px 16px;
    border-left: 2px solid transparent;
    font-size: 14px;
    color: var(--color-muted);
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .toc-link:hover {
    color: var(--color-ink);
  }
  .toc-link[aria-current='true'] {
    color: var(--color-ink);
    font-weight: 560;
    border-left-color: var(--color-accent);
  }
  .doc-block + .doc-block {
    margin-top: 4.5rem;
    padding-top: 4.5rem;
    border-top: 1px solid var(--color-line);
  }
</style>

<script>
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')].map((a) => [a.hash.slice(1), a]),
  );
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(entry.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  document.querySelectorAll('[data-section], #preguntas').forEach((section) => io.observe(section));
</script>
