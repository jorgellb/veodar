      transform: scale(0.4);
      opacity: 0.2;
    }
    50% {
      transform: scale(1);
      opacity: 1;
    }
  }
  .glyph .g-explode {
    animation: g-explode 4.4s var(--ease-spring) infinite;
  }
  @keyframes g-explode {
    0%,
    20%,
