---
// The frame every example of the technology pages sits in: it says out loud that it
// is an example on sample data, gives a way to start again and holds the styles they
// all share, including the phone the mobile examples are drawn in and the window of
// the desktop ones.
import Icon from '../Icon.astro';
import { langOf } from '../../i18n';

interface Props {
  id: string;
  /** Strings the example's script needs, in the language of the page. */
  strings?: Record<string, unknown>;
  /** "simulated" for the ones that imitate a system that is not there. */
  kind?: 'sample' | 'simulated' | 'real';
}
const { id, strings = {}, kind = 'sample' } = Astro.props;
const lang = langOf(Astro.url);
const T = {
  es: { sample: 'Ejemplo · datos de muestra', simulated: 'Demostración simulada · datos de muestra', real: 'Ejemplo funcional · datos de muestra', reset: 'Empezar de nuevo', label: 'Ejemplo interactivo' },
  en: { sample: 'Example · sample data', simulated: 'Simulated demo · sample data', real: 'Working example · sample data', reset: 'Start again', label: 'Interactive example' },
}[lang];
---

<div class="dm tile" data-demo={id} data-strings={JSON.stringify(strings)} role="group" aria-label={T.label} data-node>
  <div class="dm-bar">
    <p class="dm-tag">{T[kind]}</p>
    <button type="button" class="dm-reset" data-demo-reset><Icon name="refresh" size={14} /> {T.reset}</button>
  </div>
  <div class="dm-body">
    <slot />
  </div>
  <p class="sr-only" aria-live="polite" data-demo-live></p>
</div>

<style is:global>
  .dm {
    padding: 10px;
    border-radius: 28px;
  }
  .dm-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    padding: 0.5rem 0.7rem 0.9rem;
  }
  .dm-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 560;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }
  .dm-tag::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px rgb(255 90 31 / 0.18);
  }
  .dm-reset {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 32px;
    padding: 0 0.8rem;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 540;
    color: var(--color-ink-2);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .dm-reset:hover {
    background: #fff;
  }
  .dm-body {
    border-radius: 20px;
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-line);
    padding: 14px;
  }
  .dm-grid {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 860px) {
    .dm-grid--2 {
      grid-template-columns: 1fr 1fr;
    }
    .dm-grid--3 {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .dm-grid--wide {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .dm-body {
      padding: 18px;
    }
  }
  .dm-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    padding: 16px;
    border-radius: 16px;
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .dm-panel--dark {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: none;
  }
  .dm-cap {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .dm-panel--dark .dm-cap {
    color: rgb(244 240 230 / 0.6);
  }
  .dm-field {
    display: grid;
    gap: 0.3rem;
    font-size: 13.5px;
    font-weight: 540;
    color: var(--color-ink-2);
  }
  .dm-input {
    width: 100%;
    min-height: 40px;
    padding: 0.5rem 0.7rem;
    border-radius: 10px;
    background: #fff;
    color: var(--color-ink);
    font: inherit;
    font-size: 15px;
    font-weight: 400;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  textarea.dm-input {
    min-height: 84px;
    resize: vertical;
    line-height: 1.45;
  }
  .dm-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .dm-input[aria-invalid='true'] {
    box-shadow: inset 0 0 0 1.5px #c2362b;
  }
  .dm-help {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-muted);
  }
  .dm-error {
    font-size: 13px;
    font-weight: 540;
    line-height: 1.4;
    color: #a52a20;
  }
  .dm-check {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 14px;
    color: var(--color-ink-2);
    cursor: pointer;
  }
  .dm-check input {
    width: 18px;
    height: 18px;
    accent-color: var(--color-accent);
  }
  .dm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 40px;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 14px;
    font-weight: 560;
    cursor: pointer;
    transition:
      background-color 0.2s,
      opacity 0.2s;
  }
  .dm-btn:hover {
    background: #000;
  }
  .dm-btn--ghost {
    background: transparent;
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  .dm-btn--ghost:hover {
    background: #fff;
  }
  .dm-btn[aria-pressed='true'] {
    background: var(--color-accent);
    color: #1a0a03;
    box-shadow: none;
  }
  .dm-btn[aria-disabled='true'],
  .dm-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .dm-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  /* A pipeline: each step shows where it stands. */
  .dm-steps {
    display: grid;
    gap: 0.5rem;
  }
  .dm-steps li {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0.75rem 0.6rem 2.2rem;
    border-radius: 12px;
    background: rgb(22 20 44 / 0.04);
    font-size: 14.5px;
    font-weight: 540;
    line-height: 1.3;
  }
  .dm-steps li::before {
    content: '';
    position: absolute;
    left: 0.75rem;
    top: 0.82rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--color-line-strong);
  }
  .dm-steps small {
    font-size: 13px;
    font-weight: 400;
    color: var(--color-muted);
  }
  .dm-steps small:empty {
    display: none;
  }
  .dm-steps li[data-state='run'] {
    background: var(--color-butter);
  }
  .dm-steps li[data-state='run']::before {
    background: #8a6a00;
    box-shadow: none;
    animation: dm-blink 0.9s ease-in-out infinite;
  }
  .dm-steps li[data-state='ok'] {
    background: var(--color-mint);
  }
  .dm-steps li[data-state='ok']::before {
    background: #1f7a4d;
    box-shadow: none;
  }
  .dm-steps li[data-state='warn'] {
    background: var(--color-butter);
  }
  .dm-steps li[data-state='warn']::before {
    background: #8a6a00;
    box-shadow: none;
  }
  .dm-steps li[data-state='err'] {
    background: var(--color-blush);
  }
  .dm-steps li[data-state='err']::before {
    background: #c2362b;
    box-shadow: none;
  }
  .dm-steps li[data-state='warn'] small,
  .dm-steps li[data-state='err'] small,
  .dm-steps li[data-state='ok'] small,
  .dm-steps li[data-state='run'] small {
    color: var(--color-ink-2);
  }
  @keyframes dm-blink {
    50% {
      opacity: 0.3;
    }
  }
  .dm-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.14rem 0.55rem;
    border-radius: 999px;
    background: rgb(22 20 44 / 0.07);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .dm-pill[data-state='ok'] {
    background: var(--color-mint);
    color: #14573a;
  }
  .dm-pill[data-state='warn'] {
    background: var(--color-butter);
    color: #5f4900;
  }
  .dm-pill[data-state='err'] {
    background: var(--color-blush);
    color: #8f241b;
  }
  .dm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }
  .dm-table th {
    padding: 0.35rem 0.5rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-line);
  }
  .dm-table td {
    padding: 0.45rem 0.5rem;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .dm-table tr[data-flag] td {
    background: rgb(248 210 195 / 0.5);
  }
  .dm-table tr[data-new] td {
    background: rgb(205 235 214 / 0.55);
  }
  .dm-empty {
    font-size: 14px;
    color: var(--color-muted);
  }
  /* A server log: what happened, line by line. */
  .dm-log {
    display: grid;
    gap: 0.3rem;
    min-height: 5.5rem;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .dm-log li[data-state='ok'] {
    color: #8fe3b6;
  }
  .dm-log li[data-state='err'] {
    color: #ffb4aa;
  }
  .dm-log li[data-state='warn'] {
    color: #f6e7a6;
  }
  /* A browser window drawn in HTML: a page inside the example. */
  .dm-window {
    border-radius: 14px;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    overflow: hidden;
  }
  .dm-window-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-muted);
  }
  .dm-window-bar::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow:
      12px 0 0 var(--color-line-strong),
      24px 0 0 var(--color-line-strong);
    margin-right: 26px;
  }
  .dm-window-body {
    padding: 1rem 1rem 1.2rem;
  }
  /* A phone drawn in HTML: the examples of the mobile pages happen inside one. Two
     families, told apart only by their corners and their bottom bar; no maker's mark. */
  .dm-phone {
    width: min(100%, 248px);
    margin-inline: auto;
    padding: 8px;
    border-radius: 34px;
    background: #16142c;
    box-shadow:
      0 0 0 1px rgb(22 20 44 / 0.35),
      0 22px 40px -26px rgb(22 20 44 / 0.6);
  }
  .dm-phone[data-kind='b'] {
    border-radius: 24px;
  }
  .dm-phone-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 420px;
    border-radius: 27px;
    background: var(--color-paper);
    color: var(--color-ink);
    overflow: hidden;
  }
  .dm-phone[data-kind='b'] .dm-phone-screen {
    border-radius: 17px;
  }
  .dm-phone-screen[data-dark] {
    background: #16142c;
    color: var(--color-paper);
  }
  .dm-phone-status {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 9px 16px 5px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
  }
  .dm-phone-status > :last-child {
    justify-self: end;
    font-weight: 500;
    opacity: 0.7;
  }
  .dm-phone-cut {
    width: 52px;
    height: 15px;
    border-radius: 999px;
    background: #16142c;
  }
  .dm-phone[data-kind='b'] .dm-phone-cut {
    width: 9px;
    height: 9px;
  }
  .dm-phone-screen[data-dark] .dm-phone-cut {
    background: #000;
  }
  .dm-phone-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 0;
    padding: 8px 12px 10px;
    font-size: 13px;
    line-height: 1.35;
  }
  .dm-phone-title {
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .dm-phone-sub {
    font-size: 12px;
    color: var(--color-muted);
  }
  .dm-phone-screen[data-dark] .dm-phone-sub {
    color: rgb(244 240 230 / 0.6);
  }
  .dm-phone-row {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 40px;
    padding: 7px 10px;
    border-radius: 12px;
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
    text-align: left;
    font-size: 13px;
  }
  button.dm-phone-row {
    cursor: pointer;
  }
  .dm-phone-screen[data-dark] .dm-phone-row {
    background: rgb(244 240 230 / 0.08);
    box-shadow: none;
  }
  .dm-phone-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 13.5px;
    font-weight: 560;
    cursor: pointer;
  }
  .dm-phone[data-kind='b'] .dm-phone-btn {
    border-radius: 12px;
  }
  .dm-phone-btn[data-tone='ghost'] {
    background: transparent;
    color: inherit;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  .dm-phone-btn:disabled,
  .dm-phone-btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
  }
  /* The bottom of each family: a bar to swipe, or three keys. */
  .dm-phone-end {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 34px;
    height: 22px;
    flex: none;
  }
  .dm-phone-end::before {
    content: '';
    width: 86px;
    height: 4px;
    border-radius: 999px;
    background: currentcolor;
    opacity: 0.28;
  }
  /* Back, home and recents: a triangle, a circle and a square. */
  .dm-phone[data-kind='b'] .dm-phone-end::before {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    opacity: 0.4;
    background: none;
    border: 1.5px solid currentcolor;
  }
  .dm-phone[data-kind='b'] .dm-phone-end {
    position: relative;
  }
  .dm-phone[data-kind='b'] .dm-phone-end::after {
    content: '';
    position: absolute;
    left: calc(50% - 44px);
    width: 0;
    height: 0;
    border: 5.5px solid transparent;
    border-right-color: currentcolor;
    border-left: 0;
    opacity: 0.4;
  }
  .dm-phone-end > i {
    display: none;
  }
  .dm-phone[data-kind='b'] .dm-phone-end > i {
    display: block;
    position: absolute;
    left: calc(50% + 34px);
    width: 9px;
    height: 9px;
    border-radius: 2px;
    border: 1.5px solid currentcolor;
    opacity: 0.4;
  }
  .dm-phone :is(button, [role='checkbox'], [tabindex]):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* A desktop window drawn in HTML: the examples of the desktop pages happen inside
     one. A dark title bar with three plain keys; nothing that belongs to one system. */
  .dm-app {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: 12px;
    background: #fff;
    box-shadow:
      inset 0 0 0 1px var(--color-line-strong),
      0 16px 30px -22px rgb(22 20 44 / 0.5);
    overflow: hidden;
  }
  .dm-app-bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 0.75rem;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 12.5px;
    font-weight: 540;
  }
  .dm-app-bar > span:first-child {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dm-app-keys {
    display: flex;
    gap: 6px;
  }
  .dm-app-keys i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1.5px rgb(244 240 230 / 0.5);
  }
  .dm-app-body {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.9rem;
  }
  .dm-app-status {
    padding: 0.4rem 0.75rem;
    border-top: 1px solid var(--color-line);
    background: rgb(22 20 44 / 0.03);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
  .dm-app-status[data-state='ok'] {
    color: #14573a;
  }
  .dm-app-status[data-state='err'] {
    color: #8f241b;
  }
  /* A switch: a checkbox that reads as on or off. */
  .dm-switch {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 40px;
    font-size: 14px;
    cursor: pointer;
  }
  .dm-switch input {
    appearance: none;
    flex: none;
    position: relative;
    width: 38px;
    height: 22px;
    border-radius: 999px;
    background: rgb(22 20 44 / 0.16);
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .dm-switch input::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgb(22 20 44 / 0.3);
    transition: transform 0.2s;
  }
  .dm-switch input:checked {
    background: var(--color-ink);
  }
  .dm-switch input:checked::after {
    transform: translateX(16px);
  }
  .dm-switch input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .dm-steps li[data-state='run']::before {
      animation: none;
    }
    .dm-switch input,
    .dm-switch input::after {
      transition: none;
    }
  }
</style>
