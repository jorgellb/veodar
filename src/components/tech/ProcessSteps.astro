---
// The five steps of a job, drawn the way the cam programmer of the home page keeps
// them: one track per step, one raised pin on it and the lamp that pin lights.
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---

<ol class="pc">
  {
    steps.map((step, index) => (
      <li class="pc-step" data-reveal style={`--d:${index * 90}ms`}>
        <span class="pc-n">{String(index + 1).padStart(2, '0')}</span>
        <span class="pc-track" aria-hidden="true">
          {steps.map((_, pin) => (
            <i data-on={pin === index ? '' : undefined} />
          ))}
          <b />
        </span>
        <div class="pc-text">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .pc {
    display: grid;
  }
  .pc-step {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.9rem 1.2rem;
    align-items: start;
    padding: 1.5rem 0;
    border-top: 1px solid rgb(244 240 230 / 0.14);
  }
  .pc-step:last-child {
    border-bottom: 1px solid rgb(244 240 230 / 0.14);
  }
  .pc-n {
    padding-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-accent);
  }
  .pc-track {
    display: none;
  }
  .pc-text h3 {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .pc-text p {
    margin-top: 0.5rem;
    max-width: 56ch;
    font-size: 15.5px;
    line-height: 1.6;
    color: rgb(244 240 230 / 0.72);
    text-wrap: pretty;
  }
  @media (min-width: 720px) {
    .pc-step {
      grid-template-columns: 2.6rem 124px 1fr;
    }
    /* A track of the drum: five places for a pin, one raised, and its lamp at the end. */
    .pc-track {
      position: relative;
      display: flex;
      align-items: flex-end;
      gap: 9px;
      height: 22px;
      margin-top: 0.35rem;
      padding-bottom: 5px;
      border-bottom: 1px solid rgb(244 240 230 / 0.28);
    }
    .pc-track i {
      width: 5px;
      height: 3px;
      border-radius: 1.5px 1.5px 0 0;
      background: rgb(244 240 230 / 0.3);
    }
    .pc-track i[data-on] {
      height: 13px;
      background: var(--color-accent);
    }
    .pc-track b {
      width: 11px;
      height: 11px;
      margin-left: auto;
      margin-bottom: -1px;
      border-radius: 50%;
      box-shadow: inset 0 0 0 1.5px rgb(244 240 230 / 0.4);
      transition:
        background-color 0.5s,
        box-shadow 0.5s;
      transition-delay: calc(var(--d, 0ms) + 500ms);
    }
    /* The lamp comes on once the step has scrolled into view. */
    .pc-step.is-in .pc-track b,
    :global(html:not(.js)) .pc-track b {
      background: var(--color-accent);
      box-shadow:
        inset 0 0 0 1.5px var(--color-accent),
        0 0 10px rgb(255 90 31 / 0.6);
    }
  }
</style>
