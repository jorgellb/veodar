---
// Language switch: a two-segment control whose thumb slides to the active language
// and leans toward the other one on hover. Each option is a real link to the same
// page in that language (hreflang), so it works without JavaScript and crawlers
// can follow it. Pages with no counterpart (404) link to each home page.
import { alternatesOf, langName, langOf, LANGS, pathTo } from '../i18n';

interface Props {
  /** bar: compact ES · EN for the header; sheet: full names for the phone menu. */
  variant?: 'bar' | 'sheet';
}
const { variant = 'bar' } = Astro.props;
const lang = langOf(Astro.url);
const alternates = alternatesOf(Astro.url.pathname) ?? { es: pathTo('home', 'es'), en: pathTo('home', 'en') };
const label = { es: 'Idioma', en: 'Language' }[lang];
---

<div class:list={['ls', `ls--${variant}`]} role="group" aria-label={label} data-active={lang} data-ls>
  <span class="ls-thumb" aria-hidden="true"></span>
  {
    LANGS.map((code) =>
      code === lang ? (
        <span class="ls-opt" data-lang={code} aria-current="true" lang={code}>
          {variant === 'bar' ? code.toUpperCase() : langName[code]}
        </span>
      ) : (
        <a class="ls-opt" data-lang={code} href={alternates[code]} hreflang={code} lang={code} title={langName[code]} data-ls-go>
          {variant === 'bar' ? code.toUpperCase() : langName[code]}
        </a>
      ),
    )
  }
</div>

<style>
  .ls {
    --ls-pad: 3px;
    --ls-thumb: currentColor;
    --ls-on: var(--color-paper);
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: var(--ls-pad);
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 22%, transparent);
    isolation: isolate;
  }
  .ls-thumb {
    position: absolute;
    z-index: -1;
    top: var(--ls-pad);
    bottom: var(--ls-pad);
    left: var(--ls-pad);
    width: calc(50% - var(--ls-pad));
    border-radius: 999px;
    background: var(--ls-thumb);
    transform-origin: left center;
    transition:
      transform 0.5s var(--ease-spring),
      width 0.5s var(--ease-spring);
  }
  .ls[data-active='en'] .ls-thumb {
    transform: translateX(100%);
    transform-origin: right center;
  }
  /* Leaning toward the other language before you commit. */
  .ls[data-active='es']:has(.ls-opt[data-lang='en']:hover) .ls-thumb {
    transform: scaleX(1.18);
  }
  .ls[data-active='en']:has(.ls-opt[data-lang='es']:hover) .ls-thumb {
    transform: translateX(100%) scaleX(1.18);
  }
  .ls[data-going] .ls-thumb {
    transition-duration: 0.42s;
  }
  .ls[data-going='en'] .ls-thumb {
    transform: translateX(100%);
  }
  .ls[data-going='es'] .ls-thumb {
    transform: none;
  }
  .ls-opt {
    position: relative;
    display: grid;
    place-items: center;
    color: inherit;
    transition:
      color 0.35s,
      opacity 0.25s;
    -webkit-tap-highlight-color: transparent;
  }
  .ls-opt[aria-current] {
    color: var(--ls-on);
  }
  a.ls-opt {
    opacity: 0.62;
  }
  a.ls-opt:hover {
    opacity: 1;
  }
  .ls[data-going] .ls-opt[aria-current] {
    color: inherit;
  }
  .ls[data-going] a.ls-opt {
    color: var(--ls-on);
    opacity: 1;
  }
  a.ls-opt:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 999px;
  }

  /* Header: two monospace letters. */
  .ls--bar {
    display: none;
    height: 32px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 560;
    letter-spacing: 0.08em;
  }
  .ls--bar .ls-opt {
    width: 36px;
    height: 26px;
  }
  @media (min-width: 768px) {
    .ls--bar {
      display: inline-grid;
    }
  }

  /* Phone menu: full names, on the night panel. */
  .ls--sheet {
    --ls-pad: 4px;
    --ls-thumb: var(--color-paper);
    --ls-on: var(--color-night);
    width: 100%;
    max-width: 320px;
    height: 48px;
    color: var(--color-paper);
    font-size: 15px;
    font-weight: 540;
  }
  .ls--sheet .ls-opt {
    height: 40px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ls-thumb {
      transition: none;
    }
  }
</style>

<script>
  // Slide the thumb across before the page changes, so the switch feels physical.
  document.querySelectorAll<HTMLElement>('[data-ls]').forEach((group) => {
    group.querySelectorAll<HTMLAnchorElement>('[data-ls-go]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        event.preventDefault();
        group.setAttribute('data-going', link.dataset.lang!);
        try {
          localStorage.setItem('veodar:lang', link.dataset.lang!);
        } catch {
          // Storage may be blocked; the choice still navigates.
        }
        setTimeout(() => (location.href = link.href), 260);
      });
    });
  });
</script>
