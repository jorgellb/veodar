---
// The installers of the published version, by system: each file links straight to the
// GitHub release (the release workflow of the program's repository puts them there),
// with its size. The visitor's own system is marked when the browser says which it is.
// Honest about the first run: the installers are not signed yet, so the systems warn.
import Icon from '../Icon.astro';
import { VD_RELEASES, VD_VERSION, vdDownloads, vdDownloadUrl, vdFor } from '../../data/veodardental';
import { langOf, pathTo } from '../../i18n';

const lang = langOf(Astro.url);
const { download: d } = vdFor(lang);
---

<div class="vd-dl" data-vd-dl>
  <p class="vd-dl-version">
    <span>{d.version} {VD_VERSION}</span>
    <a href={`${VD_RELEASES}/tag/v${VD_VERSION}`} target="_blank" rel="noopener" class="vd-dl-notes">
      {d.notes} <Icon name="arrow" size={14} />
    </a>
  </p>
  <ul class="vd-dl-systems">
    {
      d.systems.map((system) => (
        <li class="vd-dl-system" data-os={system.id}>
          <p class="vd-dl-yours" aria-hidden="true">{d.yours}</p>
          <h3 class="vd-dl-name">{system.name}</h3>
          <p class="vd-dl-req">{system.req}</p>
          <ul class="vd-dl-files">
            {system.files.map((file, index) => {
              const { file: name, mb } = vdDownloads[file.key];
              const ext = name.endsWith('.pkg.tar.zst') ? '.pkg.tar.zst' : name.endsWith('.tar.gz') ? '.tar.gz' : name.slice(name.lastIndexOf('.'));
              return (
                <li>
                  <a href={vdDownloadUrl(file.key)} class:list={['vd-dl-file', index === 0 && 'vd-dl-file--main']}>
                    <span class="vd-dl-label">{file.label}</span>
                    <span class="vd-dl-meta">
                      {ext} · {mb} MB
                    </span>
                    <span class="vd-dl-icon" aria-hidden="true">
                      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 3.5v9M6.2 8.8 10 12.6l3.8-3.8M4 16.5h12" />
                      </svg>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </li>
      ))
    }
  </ul>

  <div class="vd-dl-foot">
    <div class="vd-dl-first">
      <span class="vd-dl-first-icon">
        <Icon name="shield" size={17} />
      </span>
      <div>
        <p class="vd-dl-first-title">{d.firstTime.title}</p>
        <p class="vd-dl-first-text">{d.firstTime.text}</p>
        <ul class="vd-dl-first-list">
          <li>{d.firstTime.windows}</li>
          <li>{d.firstTime.mac}</li>
        </ul>
      </div>
    </div>
    <div class="vd-dl-clinic">
      <p>{d.clinic}</p>
      <a href={pathTo('contacto', lang)} class="link-arrow vd-dl-contact">
        {d.contact} <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>
</div>

<style>
  .vd-dl-version {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink-2);
  }
  .vd-dl-notes {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans, inherit);
    font-size: 14px;
    color: #0f766e;
  }
  .vd-dl-notes:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .vd-dl-systems {
    margin-top: 1.25rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .vd-dl-systems {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }
  .vd-dl-system {
    position: relative;
    padding: 1.4rem;
    border-radius: 22px;
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition: box-shadow 0.3s;
  }
  .vd-dl-system[data-yours] {
    box-shadow:
      inset 0 0 0 2px #0d9488,
      0 18px 40px -24px rgb(13 148 136 / 0.7);
  }
  .vd-dl-yours {
    display: none;
    position: absolute;
    top: -0.7rem;
    right: 1.2rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #fff;
    background: #0d9488;
  }
  .vd-dl-system[data-yours] .vd-dl-yours {
    display: block;
  }
  .vd-dl-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .vd-dl-req {
    margin-top: 0.3rem;
    min-height: 2.9em;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .vd-dl-files {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
  }
  .vd-dl-file {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'label icon' 'meta icon';
    align-items: center;
    column-gap: 0.75rem;
    padding: 0.6rem 0.8rem 0.6rem 0.95rem;
    border-radius: 14px;
    background: rgb(13 148 136 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(13 148 136 / 0.18);
    transition:
      background-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }
  .vd-dl-file:hover {
    background: rgb(13 148 136 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(13 148 136 / 0.45);
  }
  .vd-dl-file:active {
    transform: scale(0.99);
  }
  .vd-dl-file--main {
    color: #04221f;
    background: #2dd4bf;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 10px 24px -14px rgb(13 148 136 / 0.9);
  }
  .vd-dl-file--main:hover {
    background: #5eead4;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 10px 24px -14px rgb(13 148 136 / 0.9);
  }
  .vd-dl-label {
    grid-area: label;
    font-size: 14.5px;
    font-weight: 560;
    line-height: 1.3;
  }
  .vd-dl-meta {
    grid-area: meta;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-ink-2);
  }
  .vd-dl-file--main .vd-dl-meta {
    color: #0b3b36;
  }
  .vd-dl-icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    color: #0f766e;
    background: #fff;
  }
  .vd-dl-file--main .vd-dl-icon {
    color: #04221f;
    background: rgb(255 255 255 / 0.55);
  }
  .vd-dl-file:focus-visible {
    outline: 2px solid #0d9488;
    outline-offset: 3px;
  }

  .vd-dl-foot {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .vd-dl-foot {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }
  .vd-dl-first {
    display: flex;
    gap: 0.9rem;
    padding: 1.2rem 1.3rem;
    border-radius: 20px;
    background: #fff8eb;
    box-shadow: inset 0 0 0 1px #f3dfb8;
  }
  .vd-dl-first-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 11px;
    color: #9a5b00;
    background: #fdecc8;
  }
  .vd-dl-first-title {
    font-weight: 600;
    font-size: 15px;
  }
  .vd-dl-first-text {
    margin-top: 0.25rem;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .vd-dl-first-list {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.3rem;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .vd-dl-first-list li {
    padding-left: 0.9rem;
    border-left: 2px solid #f3dfb8;
  }
  .vd-dl-clinic {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.7rem;
    padding: 1.2rem 1.3rem;
    border-radius: 20px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--color-ink-2);
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .vd-dl-contact {
    color: #0f766e;
    font-weight: 560;
  }
</style>

<script>
  // Mark the visitor's system, when the browser says which it is (nothing is sent anywhere).
  const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
  const platform = (nav.userAgentData?.platform || navigator.platform || navigator.userAgent).toLowerCase();
  const os = /win/.test(platform) ? 'windows' : /mac/.test(platform) && !/iphone|ipad/.test(navigator.userAgent.toLowerCase()) ? 'macos' : /linux|x11/.test(platform) && !/android/.test(navigator.userAgent.toLowerCase()) ? 'linux' : null;
  if (os) document.querySelectorAll(`[data-vd-dl] [data-os="${os}"]`).forEach((el) => el.setAttribute('data-yours', ''));
</script>
