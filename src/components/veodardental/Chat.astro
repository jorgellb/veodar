---
// A reminder as the patient gets it, their answer, and the appointment changing state in
// the schedule by itself. It plays once when it comes into view; with "reduce motion" it
// is shown finished. A plain message thread: no messaging app's look.
import Icon from '../Icon.astro';
import { vdFor } from '../../data/veodardental';
import { langOf } from '../../i18n';

const lang = langOf(Astro.url);
const { chat } = vdFor(lang).desk;
const label = lang === 'en' ? 'Example: an appointment reminder and its answer' : 'Ejemplo: un recordatorio de cita y su respuesta';
---

<div class="vd-chat" data-reveal role="img" aria-label={`${label}. ${chat.reminder} — ${chat.reply}. ${chat.confirmed}.`}>
  <div class="vd-chat-phone" aria-hidden="true">
    <div class="vd-chat-head">
      <span class="vd-chat-avatar">
        <Icon name="cross" size={15} />
      </span>
      <span class="vd-chat-name">{chat.clinic}</span>
    </div>
    <div class="vd-chat-thread">
      <p class="vd-msg vd-msg--in" style="--t:200ms">
        {chat.reminder}
        <span class="vd-msg-time">{chat.time}</span>
      </p>
      <p class="vd-msg vd-msg--out" style="--t:1100ms">
        <span class="vd-typing"><i></i><i></i><i></i></span>
        <span class="vd-reply">{chat.reply}</span>
        <span class="vd-msg-time">{chat.replyTime} ✓✓</span>
      </p>
      <p class="vd-sys" style="--t:2700ms">
        <Icon name="check" size={13} />
        {chat.confirmed}
      </p>
    </div>
  </div>

  <div class="vd-chat-agenda" aria-hidden="true">
    <p class="vd-chat-agenda-title">{chat.agenda}</p>
    <div class="vd-appt vd-appt--done">
      <span class="vd-appt-time">09:30</span>
      <span class="vd-appt-body">
        <strong>Ana García López</strong>
        <span>{lang === 'en' ? 'Filling 47 · Dr Ruiz' : 'Obturación 47 · Dra. Ruiz'}</span>
      </span>
      <span class="vd-appt-state">
        <span class="vd-appt-was">{chat.planned}</span>
        <span class="vd-appt-now">{chat.done}</span>
      </span>
    </div>
  </div>
</div>

<style>
  .vd-chat {
    position: relative;
    display: grid;
    justify-items: center;
    padding: 2.25rem 1.25rem 4.5rem;
    border-radius: 28px;
    background:
      radial-gradient(420px 260px at 70% 20%, rgb(45 212 191 / 0.22), transparent 70%),
      linear-gradient(160deg, #e6f4f1, #dfe9f6);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .vd-chat-phone {
    width: min(100%, 330px);
    border-radius: 30px;
    padding: 10px;
    background: #0d1c31;
    box-shadow:
      0 30px 60px -28px rgb(13 28 49 / 0.65),
      inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .vd-chat-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px 12px;
    color: #eef2f7;
  }
  .vd-chat-avatar {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 10px;
    background: #0d9488;
    color: #fff;
  }
  .vd-chat-name {
    font-size: 14px;
    font-weight: 560;
  }
  .vd-chat-thread {
    display: grid;
    gap: 10px;
    align-content: start;
    min-height: 300px;
    padding: 16px 12px 18px;
    border-radius: 22px;
    background: #f1f4f8;
  }
  .vd-msg {
    position: relative;
    max-width: 86%;
    padding: 9px 12px 20px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.4;
    color: #16253d;
  }
  .vd-msg--in {
    justify-self: start;
    background: #fff;
    border-top-left-radius: 5px;
    box-shadow: 0 1px 2px rgb(13 28 49 / 0.08);
  }
  .vd-msg--out {
    justify-self: end;
    background: #cdeee8;
    border-top-right-radius: 5px;
  }
  .vd-msg-time {
    position: absolute;
    right: 10px;
    bottom: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: #6a7890;
  }
  .vd-typing {
    position: absolute;
    inset: 0 0 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    opacity: 0;
  }
  .vd-typing i {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: #0f766e;
    opacity: 0.55;
  }
  .vd-sys {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 560;
    color: #0f766e;
    background: rgb(13 148 136 / 0.12);
  }
  .vd-chat-agenda {
    position: absolute;
    left: 50%;
    bottom: -1.75rem;
    width: min(92%, 380px);
    transform: translateX(-50%);
    padding: 12px 14px;
    border-radius: 18px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(13 28 49 / 0.08),
      0 18px 40px -20px rgb(13 28 49 / 0.45);
  }
  .vd-chat-agenda-title {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6a7890;
  }
  .vd-appt {
    margin-top: 8px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-left: 3px solid #2563eb;
    border-radius: 8px;
    background: #eef3fd;
  }
  .vd-appt-time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #16253d;
  }
  .vd-appt-body {
    display: grid;
    font-size: 13px;
    line-height: 1.3;
    color: #16253d;
  }
  .vd-appt-body span {
    color: #5b6a82;
    font-size: 12px;
  }
  .vd-appt-state {
    display: grid;
    font-size: 12px;
    font-weight: 600;
  }
  .vd-appt-was,
  .vd-appt-now {
    grid-area: 1 / 1;
    padding: 3px 9px;
    border-radius: 999px;
    text-align: center;
  }
  .vd-appt-was {
    color: #5b6a82;
    background: #e2e8f0;
    opacity: 0;
  }
  .vd-appt-now {
    color: #fff;
    background: #0d9488;
  }

  .vd-appt--done {
    border-left-color: #0d9488;
  }

  /* The conversation plays once it is in view. Without motion, it is shown as it ends. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .vd-chat .vd-msg,
    :global(.js) .vd-chat .vd-sys {
      opacity: 0;
      transform: translateY(10px) scale(0.97);
    }
    /* The answer first shows someone typing, then the words. */
    :global(.js) .vd-chat .vd-reply,
    :global(.js) .vd-chat .vd-msg--out .vd-msg-time {
      opacity: 0;
    }
    :global(.js) .vd-chat .vd-appt-was {
      opacity: 1;
    }
    :global(.js) .vd-chat .vd-appt-now {
      opacity: 0;
      transform: scale(0.8);
    }
    :global(.js) .vd-chat.is-in .vd-msg,
    :global(.js) .vd-chat.is-in .vd-sys {
      animation: vd-in 0.55s var(--ease-out-soft) var(--t) forwards;
    }
    :global(.js) .vd-chat.is-in .vd-typing {
      animation: vd-typing 1s ease 1.1s both;
    }
    :global(.js) .vd-chat.is-in .vd-typing i {
      animation: vd-dot 0.6s ease-in-out 1.2s 2;
    }
    :global(.js) .vd-chat.is-in .vd-typing i:nth-child(2) {
      animation-delay: 1.35s;
    }
    :global(.js) .vd-chat.is-in .vd-typing i:nth-child(3) {
      animation-delay: 1.5s;
    }
    :global(.js) .vd-chat.is-in .vd-reply,
    :global(.js) .vd-chat.is-in .vd-msg--out .vd-msg-time {
      animation: vd-show 0.4s ease 2.05s forwards;
    }
    :global(.js) .vd-chat .vd-appt {
      border-left-color: #2563eb;
    }
    :global(.js) .vd-chat.is-in .vd-appt-was {
      animation: vd-out 0.35s ease 3s forwards;
    }
    :global(.js) .vd-chat.is-in .vd-appt-now {
      animation: vd-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 3.1s forwards;
    }
    :global(.js) .vd-chat.is-in .vd-appt {
      animation: vd-flash 1.4s ease 3.1s forwards;
    }
  }
  @keyframes vd-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes vd-show {
    to {
      opacity: 1;
    }
  }
  @keyframes vd-out {
    to {
      opacity: 0;
      transform: scale(0.8);
    }
  }
  @keyframes vd-typing {
    0%,
    100% {
      opacity: 0;
    }
    12%,
    85% {
      opacity: 1;
    }
  }
  @keyframes vd-dot {
    50% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }
  @keyframes vd-flash {
    30% {
      background: #d6f3ee;
    }
    to {
      border-left-color: #0d9488;
    }
  }
</style>
