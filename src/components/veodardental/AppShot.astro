---
// A screenshot of VeodarDental inside a plain application window: a title bar with the
// program's own title and neutral controls, no particular operating system.
import { Picture } from 'astro:assets';
import { shots } from './shots';
import { vdFor, type Shot } from '../../data/veodardental';
import { langOf } from '../../i18n';

interface Props {
  shot: Shot;
  /** CSS `sizes` for the picture. */
  sizes?: string;
  /** The first screen: load at once. Anything below loads when it comes near. */
  eager?: boolean;
  /** Dark frame, for dark sections. */
  dark?: boolean;
  class?: string;
}
const { shot, sizes = '(min-width: 1320px) 1240px, 94vw', eager = false, dark = false, class: className } = Astro.props;
const lang = langOf(Astro.url);
const text = vdFor(lang);
const title = lang === 'en' ? 'VeodarDental — Dental practice management' : 'VeodarDental — Gestión de clínica dental';
---

<figure class:list={['vd-window', dark && 'vd-window--dark', className]}>
  <div class="vd-window-bar" aria-hidden="true">
    <span class="vd-window-dots"><i></i><i></i><i></i></span>
    <span class="vd-window-title">{title}</span>
    <span class="vd-window-ctl"><i></i><i></i><i></i></span>
  </div>
  <Picture
    src={shots[shot]}
    alt={text.shotAlt[shot]}
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1600]}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    class="vd-window-img"
  />
</figure>

<style>
  .vd-window {
    overflow: hidden;
    border-radius: 14px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(13 28 49 / 0.14),
      0 2px 4px rgb(13 28 49 / 0.06),
      0 24px 60px -24px rgb(13 28 49 / 0.45);
  }
  .vd-window--dark {
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 30px 80px -20px rgb(0 0 0 / 0.65),
      0 0 120px -30px rgb(45 212 191 / 0.35);
  }
  .vd-window-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    background: #e9edf3;
    border-bottom: 1px solid rgb(13 28 49 / 0.1);
  }
  .vd-window--dark .vd-window-bar {
    background: #16253d;
    border-bottom-color: rgb(255 255 255 / 0.08);
  }
  .vd-window-title {
    font-size: 11.5px;
    letter-spacing: 0.01em;
    color: #4b5870;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vd-window--dark .vd-window-title {
    color: #9fb0c8;
  }
  .vd-window-dots,
  .vd-window-ctl {
    display: flex;
    gap: 6px;
  }
  .vd-window-ctl {
    justify-content: flex-end;
  }
  .vd-window-dots i {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    background: rgb(13 28 49 / 0.16);
  }
  .vd-window-ctl i {
    width: 10px;
    height: 1.5px;
    border-radius: 1px;
    background: rgb(13 28 49 / 0.3);
  }
  .vd-window--dark .vd-window-dots i {
    background: rgb(255 255 255 / 0.16);
  }
  .vd-window--dark .vd-window-ctl i {
    background: rgb(255 255 255 / 0.3);
  }
  .vd-window :global(.vd-window-img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 640px) {
    .vd-window-title {
      display: none;
    }
  }
</style>
