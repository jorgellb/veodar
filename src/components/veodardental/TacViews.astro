---
// The same invented CT study in the program's viewer, in its three planes: crops of the
// viewer from three screenshots (axial, coronal, sagittal), at the size the viewer shows
// them, side by side on a dark lightbox.
import { Picture } from 'astro:assets';
import axial from '../../assets/veodardental/tac-axial.png';
import coronal from '../../assets/veodardental/tac-coronal.png';
import sagital from '../../assets/veodardental/tac-sagital.png';
import { vdFor } from '../../data/veodardental';
import { langOf } from '../../i18n';

const lang = langOf(Astro.url);
const { views } = vdFor(lang).imaging;
const images = [axial, coronal, sagital];
---

<section class="vd-views" aria-labelledby="vd-views-title" data-reveal>
  <div class="vd-views-head">
    <h3 id="vd-views-title" class="vd-views-title">{views.title}</h3>
    <p class="vd-views-text">{views.text}</p>
  </div>
  <ul class="vd-views-list">
    {
      images.map((image, index) => (
        <li>
          <figure class="vd-views-fig">
            <Picture src={image} alt={views.alt.replace('{view}', views.labels[index])} formats={['avif', 'webp']} widths={[385]} sizes="(min-width: 1024px) 385px, 94vw" loading="lazy" decoding="async" class="vd-views-img" />
            <figcaption>{views.labels[index]}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .vd-views {
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: 28px;
    color: #eef2f7;
    background:
      radial-gradient(520px 260px at 50% 0%, rgb(45 212 191 / 0.12), transparent 70%),
      #050b14;
    box-shadow: 0 30px 70px -36px rgb(5 11 20 / 0.9);
  }
  .vd-views-head {
    display: grid;
    gap: 0.5rem 2rem;
  }
  @media (min-width: 1024px) {
    .vd-views-head {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .vd-views-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .vd-views-text {
    max-width: 62ch;
    font-size: 14.5px;
    line-height: 1.55;
    color: #9fb0c8;
  }
  .vd-views-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .vd-views-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .vd-views-fig {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: #000;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .vd-views-fig :global(.vd-views-img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .vd-views-fig figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: #04221f;
    background: #5eead4;
  }
</style>
