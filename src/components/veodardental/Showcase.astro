---
// The program, screen by screen: a row of tabs and the screenshot of each, with what it
// does beside it. Without JavaScript every panel is shown, one under the other; with it,
// one at a time (arrow keys move between tabs, as in any tab list).
import AppShot from './AppShot.astro';
import Icon from '../Icon.astro';
import { vdFor } from '../../data/veodardental';
import { langOf } from '../../i18n';

const lang = langOf(Astro.url);
const { tour, shotNote } = vdFor(lang);
---

<div class="vd-show" data-vd-show>
  <div class="vd-show-tabs" role="tablist" aria-label={tour.kicker}>
    {
      tour.tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`vd-tab-${tab.shot}`}
          aria-controls={`vd-panel-${tab.shot}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          class="vd-show-tab"
        >
          {tab.tab}
        </button>
      ))
    }
  </div>

  <div class="vd-show-stage">
    {
      tour.tabs.map((tab, index) => (
        <section
          id={`vd-panel-${tab.shot}`}
          role="tabpanel"
          aria-labelledby={`vd-tab-${tab.shot}`}
          class="vd-show-panel"
          data-active={index === 0 ? '' : undefined}
          tabindex="0"
        >
          <div class="vd-show-copy">
            <h3 class="vd-show-title">{tab.title}</h3>
            <p class="vd-show-text">{tab.text}</p>
            <ul class="vd-show-points">
              {tab.points.map((point) => (
                <li>
                  <span class="vd-show-check">
                    <Icon name="check" size={13} />
                  </span>
                  {point}
                </li>
              ))}
            </ul>
          </div>
          <AppShot shot={tab.shot} sizes="(min-width: 1320px) 860px, (min-width: 1024px) 66vw, 94vw" class="vd-show-shot" />
        </section>
      ))
    }
  </div>
  <p class="vd-show-note">{shotNote}</p>
</div>

<style>
  .vd-show-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 6px;
    margin-inline: -6px;
    scrollbar-width: none;
  }
  .vd-show-tabs::-webkit-scrollbar {
    display: none;
  }
  .vd-show-tab {
    flex: none;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 540;
    color: var(--color-ink-2);
    background: rgb(255 255 255 / 0.55);
    box-shadow: inset 0 0 0 1px var(--color-line);
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s,
      box-shadow 0.25s;
  }
  .vd-show-tab:hover {
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  .vd-show-tab[aria-selected='true'] {
    color: #fff;
    background: #0d9488;
    box-shadow:
      inset 0 0 0 1px #0d9488,
      0 8px 20px -10px rgb(13 148 136 / 0.8);
  }
  .vd-show-stage {
    margin-top: 1.75rem;
    display: grid;
  }
  .vd-show-panel {
    display: grid;
    gap: 1.75rem;
    align-items: start;
    padding-bottom: 2.5rem;
  }
  .vd-show-panel:focus-visible {
    outline: 2px solid #0d9488;
    outline-offset: 6px;
    border-radius: 16px;
  }
  @media (min-width: 1024px) {
    .vd-show-panel {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
      gap: 3rem;
    }
    .vd-show-copy {
      position: sticky;
      top: 7rem;
      padding-top: 1rem;
    }
  }
  .vd-show-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .vd-show-text {
    margin-top: 0.9rem;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .vd-show-points {
    margin-top: 1.4rem;
    display: grid;
    gap: 0.7rem;
  }
  .vd-show-points li {
    display: flex;
    gap: 0.65rem;
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .vd-show-check {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 999px;
    color: #fff;
    background: #0d9488;
  }
  .vd-show-note {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  /* With JavaScript, the panels share one cell and only the chosen one shows. */
  :global(.js) .vd-show-panel {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.45s var(--ease-out-soft),
      transform 0.6s var(--ease-out-soft),
      visibility 0s linear 0.45s;
  }
  :global(.js) .vd-show-panel[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.45s var(--ease-out-soft),
      transform 0.6s var(--ease-out-soft),
      visibility 0s;
  }
  :global(.js) .vd-show-panel :global(.vd-window) {
    transform: scale(0.985);
    transition: transform 0.8s var(--ease-out-soft);
  }
  :global(.js) .vd-show-panel[data-active] :global(.vd-window) {
    transform: none;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-vd-show]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => root.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`)!);
    const select = (index: number, focus = false, scroll = true) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].toggleAttribute('data-active', on);
        // The hidden panels stay in the page for the layout, but out of reach.
        panels[i].inert = !on;
      });
      if (focus) tabs[index].focus();
      // Bring a tab half out of the row into view (on a phone the row scrolls sideways).
      if (scroll) tabs[index].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: last }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        select((next + tabs.length) % tabs.length, true);
      });
    });
    select(0, false, false);
  }
</script>
