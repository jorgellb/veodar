---
import Icon from './Icon.astro';
import type { Faq } from '../data/pages';
import { langOf } from '../i18n';
import { linkify } from '../i18n/links';

interface Props {
  items: Faq[];
  title?: string;
  id?: string;
  /** Turn key terms in the answers into links (on by default). */
  links?: boolean;
}
const lang = langOf(Astro.url);
const T = {
  es: { title: 'Preguntas frecuentes', eyebrow: 'Preguntas', missing: '¿Falta la tuya? Escríbela a', reply: 'y te respondemos con una pregunta concreta, no con un dossier.' },
  en: { title: 'Frequently asked questions', eyebrow: 'Questions', missing: 'Missing yours? Write it to', reply: "and we'll reply with a specific question, not a brochure." },
}[lang];
const { items, title = T.title, id = 'preguntas', links = true } = Astro.props;
// Answers can carry contextual links to services (see src/i18n/links.ts).
const answer = (text: string) => (links ? linkify(text, lang, Astro.url.pathname, 1) : escapeHtml(text));
function escapeHtml(text: string) {
  return text.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
}
---

<section id={id} class="py-24 md:py-32" data-spine="0.404" aria-labelledby={`${id}-title`}>
  <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow">{T.eyebrow}</p>
      <h2 id={`${id}-title`} class="display h-lg mt-5 max-w-[12ch]">{title}</h2>
      <p class="mt-6 max-w-[34ch] text-[15px] leading-relaxed text-muted">
        {T.missing} <a class="link-arrow" href="mailto:info@veodar.com">info@veodar.com</a> {T.reply}
      </p>
    </div>
    <div class="border-t border-line">
      {
        items.map((item) => (
          <details class="faq">
            <summary>
              <span>{item.q}</span>
              <span class="faq-ico" aria-hidden="true">
                <Icon name="close" size={16} />
              </span>
            </summary>
            <div class="faq-body">
              <p set:html={answer(item.a)} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    border-bottom: 1px solid var(--color-line);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    font-weight: 540;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-ico {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    transform: rotate(45deg);
    transition:
      transform 0.45s var(--ease-spring),
      background-color 0.3s;
  }
  .faq[open] .faq-ico {
    transform: rotate(0deg);
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .faq-body {
    padding: 0 3.5rem 1.6rem 0;
    color: var(--color-ink-2);
    line-height: 1.7;
  }
  @supports (interpolate-size: allow-keywords) {
    .faq {
      interpolate-size: allow-keywords;
    }
    .faq::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 0.45s var(--ease-spring),
        content-visibility 0.45s allow-discrete;
    }
    .faq[open]::details-content {
      height: auto;
    }
  }
</style>
