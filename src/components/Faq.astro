---
import Icon from './Icon.astro';
import type { Faq } from '../data/pages';

interface Props {
  items: Faq[];
  title?: string;
  id?: string;
}
const { items, title = 'Preguntas frecuentes', id = 'preguntas' } = Astro.props;
---

<section id={id} class="py-24 md:py-32" data-spine="0.404" aria-labelledby={`${id}-title`}>
  <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow">Preguntas</p>
      <h2 id={`${id}-title`} class="display h-lg mt-5 max-w-[12ch]">{title}</h2>
      <p class="mt-6 max-w-[34ch] text-[15px] leading-relaxed text-muted">
        ¿Falta la tuya? Escríbela a <a class="link-arrow" href="mailto:hola@veodar.com">hola@veodar.com</a> y te respondemos con una pregunta concreta, no con un dossier.
      </p>
    </div>
    <div class="border-t border-line">
      {
        items.map((item) => (
          <details class="faq">
            <summary>
              <span>{item.q}</span>
              <span class="faq-ico" aria-hidden="true">
                <Icon name="close" size={16} />
              </span>
            </summary>
            <div class="faq-body">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    border-bottom: 1px solid var(--color-line);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    font-weight: 540;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-ico {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    transform: rotate(45deg);
    transition:
      transform 0.45s var(--ease-spring),
      background-color 0.3s;
  }
  .faq[open] .faq-ico {
    transform: rotate(0deg);
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .faq-body {
    padding: 0 3.5rem 1.6rem 0;
    color: var(--color-ink-2);
    line-height: 1.7;
  }
  @supports (interpolate-size: allow-keywords) {
    .faq {
      interpolate-size: allow-keywords;
    }
    .faq::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 0.45s var(--ease-spring),
        content-visibility 0.45s allow-discrete;
    }
    .faq[open]::details-content {
      height: auto;
    }
  }
</style>
