  /* The steps go in order: a line runs from one to the next on wide screens. */
  @media (min-width: 1024px) {
    .vd-step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 2.35rem;
      left: calc(100% - 0.4rem);
      width: 1.8rem;
