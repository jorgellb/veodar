---
// /sectores/salud/veodardental/ and /en/industries/healthcare/veodardental/: the page of
// VeodarDental, our own management program for dental clinics. It wears the program's
// own colours (the night blue of its sidebar and its teal) inside the site's frame, and
// opens with the thing every dental program is judged by: the odontogram.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Arch from '../components/veodardental/Arch.astro';
import AppShot from '../components/veodardental/AppShot.astro';
import Showcase from '../components/veodardental/Showcase.astro';
import Chat from '../components/veodardental/Chat.astro';
import Chain from '../components/veodardental/Chain.astro';
import { shots } from '../components/veodardental/shots';
import { vdFor } from '../data/veodardental';
import { sectorsFor } from '../data/sectors';
import { breadcrumbLd, faqLd, site } from '../data/site';
import { langOf, pathTo, sectorHref, serviceHref, techHref } from '../i18n';
import { UPDATED } from '../data/updated';

const lang = langOf(Astro.url);
const t = vdFor(lang);
const health = sectorsFor(lang).find((s) => s.id === 'salud')!;
const url = new URL(pathTo('veodardental', lang), site.url).href;
const T = {
  es: { home: 'Inicio', sectors: 'Sectores', onPage: 'En esta página', nav: ['El programa', 'Clínica', 'Recepción', 'Cuentas', 'Seguridad', 'Cambiarse'] },
  en: { home: 'Home', sectors: 'Industries', onPage: 'On this page', nav: ['The program', 'Clinical', 'Front desk', 'Accounts', 'Security', 'Switching'] },
}[lang];
const crumbs = [
  { name: T.home, path: pathTo('home', lang) },
  { name: T.sectors, path: pathTo('sectores', lang) },
  { name: health.name, path: sectorHref('salud', lang) },
  { name: t.crumb, path: pathTo('veodardental', lang) },
];
const sections = ['programa', 'clinica', 'recepcion', 'cuentas', 'seguridad', 'cambio'];
const factIcons = ['desktop', 'grid', 'shield', 'compass'];
const trustIcons = ['desktop', 'refresh', 'layers', 'key', 'check', 'bell'];
// What the program is, for search engines: no price, no ratings (there are none to give).
const appLd = {
  '@type': 'SoftwareApplication',
  '@id': `${url}#software`,
  name: 'VeodarDental',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: lang === 'en' ? 'Dental practice management' : 'Gestión de clínicas dentales',
  operatingSystem: 'Windows, macOS, Linux',
  description: t.description,
  url,
  inLanguage: ['es', 'ca', 'eu', 'gl', 'en'],
  publisher: { '@id': `${site.url}/#organization` },
  screenshot: Object.values(shots).map((image) => new URL(image.src, site.url).href),
  featureList: t.tour.tabs.map((tab) => tab.title),
  mainEntityOfPage: { '@id': `${url}#webpage` },
};
const ld = [breadcrumbLd(crumbs), faqLd(t.faq), appLd];
---

<BaseLayout title={t.title} description={t.description} jsonLd={ld} darkHero updated={UPDATED.veodardental} mainEntity={`${url}#software`} ogImage={lang === 'en' ? '/og-veodardental-en.png' : '/og-veodardental.png'}>
  <section class="vd-hero" data-dark data-spine="0.5" aria-labelledby="vd-title">
    <div class="wrap">
      <nav aria-label={lang === 'en' ? 'Breadcrumb' : 'Migas de pan'} class="vd-crumbs">
        <ol>
          {
            crumbs.map((crumb, index) => (
              <li>
                {index > 0 && <span aria-hidden="true">/</span>}
                {index < crumbs.length - 1 ? <a href={crumb.path}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="vd-hero-grid">
        <div class="vd-hero-copy">
          <p class="eyebrow vd-eyebrow" data-reveal>{t.kicker}</p>
          <h1 id="vd-title" class="display vd-h1 mt-6" data-reveal style="--d:60ms">
            {t.h1[0]}<em>{t.h1[1].replace(' ', '\u00a0')}</em>{t.h1[2]}
          </h1>
          <p class="vd-lead mt-7" data-reveal style="--d:120ms">{t.lead}</p>
          <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--d:180ms">
            <a href={pathTo('contacto', lang)} class="btn vd-btn">
              {t.cta} <Icon name="arrow" size={17} class="arrow" />
            </a>
            <a href="#programa" class="btn vd-btn-ghost">{t.ctaTour}</a>
          </div>
          <ul class="vd-chips mt-10" data-reveal style="--d:240ms">
            {t.chips.map((chip) => <li>{chip}</li>)}
          </ul>
        </div>
        <div class="vd-hero-arch" data-reveal style="--d:100ms">
          <Arch />
        </div>
      </div>

      <div class="vd-hero-shot" data-reveal style="--d:200ms">
        <AppShot shot="agenda" dark eager sizes="(min-width: 1320px) 1240px, 94vw" />
      </div>
    </div>
  </section>

  <section class="vd-facts" aria-label={lang === 'en' ? 'In short' : 'En pocas palabras'}>
    <div class="wrap">
      <ul class="vd-facts-grid">
        {
          t.facts.map((fact, index) => (
            <li class="vd-fact" data-reveal style={`--d:${index * 70}ms`}>
              <span class="vd-fact-icon">
                <Icon name={factIcons[index]} size={18} />
              </span>
              <p class="vd-fact-title">{fact.title}</p>
              <p class="vd-fact-text">{fact.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <nav class="vd-toc" aria-label={T.onPage}>
    <div class="wrap">
      <ul>
        {sections.map((id, index) => <li><a href={`#${id}`}>{T.nav[index]}</a></li>)}
      </ul>
    </div>
  </nav>

  <section id="programa" class="vd-section" data-spine="0.303" aria-labelledby="programa-title">
    <div class="wrap">
      <div class="vd-head">
        <p class="eyebrow vd-eyebrow-teal">{t.tour.kicker}</p>
        <h2 id="programa-title" class="display h-lg mt-4 max-w-[18ch]">{t.tour.title}</h2>
        <p class="lead mt-5 max-w-[60ch]">{t.tour.text}</p>
      </div>
      <div class="mt-12">
        <Showcase />
      </div>
    </div>
  </section>

  <section id="clinica" class="vd-section vd-dark" data-dark data-spine="0.405" aria-labelledby="clinica-title">
    <div class="wrap">
      <div class="vd-split">
        <div class="vd-head">
          <p class="eyebrow vd-eyebrow">{t.clinic.kicker}</p>
          <h2 id="clinica-title" class="display h-lg mt-4 max-w-[16ch]">{t.clinic.title}</h2>
          <p class="vd-lead mt-5">{t.clinic.text}</p>
        </div>
        <div class="vd-tilt" data-reveal>
          <AppShot shot="odontograma-radiografia" dark sizes="(min-width: 1024px) 720px, 94vw" />
        </div>
      </div>
      <ul class="vd-cards vd-cards--dark mt-16">
        {
          t.clinic.features.map((feature, index) => (
            <li class="vd-card spot" data-reveal style={`--d:${(index % 3) * 70}ms`}>
              <h3 class="vd-card-title">{feature.title}</h3>
              <p class="vd-card-text">{feature.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="recepcion" class="vd-section" data-spine="0.5" aria-labelledby="recepcion-title">
    <div class="wrap vd-split vd-split--even">
      <div>
        <p class="eyebrow vd-eyebrow-teal">{t.desk.kicker}</p>
        <h2 id="recepcion-title" class="display h-lg mt-4 max-w-[16ch]">{t.desk.title}</h2>
        <p class="lead mt-5 max-w-[52ch]">{t.desk.text}</p>
        <ul class="vd-list mt-10">
          {
            t.desk.features.map((feature) => (
              <li data-reveal>
                <p class="vd-list-title">{feature.title}</p>
                <p class="vd-list-text">{feature.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <Chat />
    </div>
  </section>

  <section id="cuentas" class="vd-section vd-section--line" data-spine="0.5" aria-labelledby="cuentas-title">
    <div class="wrap">
      <div class="vd-head">
        <p class="eyebrow vd-eyebrow-teal">{t.money.kicker}</p>
        <h2 id="cuentas-title" class="display h-lg mt-4 max-w-[16ch]">{t.money.title}</h2>
        <p class="lead mt-5 max-w-[60ch]">{t.money.text}</p>
      </div>
      <div class="mt-12">
        <Chain />
      </div>
      <ul class="vd-cards mt-8">
        {
          t.money.features.map((feature, index) => (
            <li class="vd-card spot" data-reveal style={`--d:${index * 70}ms`}>
              <h3 class="vd-card-title">{feature.title}</h3>
              <p class="vd-card-text">{feature.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="seguridad" class="vd-section vd-section--tint" data-spine="0.405" aria-labelledby="seguridad-title">
    <div class="wrap">
      <div class="vd-split">
        <div class="vd-head">
          <p class="eyebrow vd-eyebrow-teal">{t.trust.kicker}</p>
          <h2 id="seguridad-title" class="display h-lg mt-4 max-w-[14ch]">{t.trust.title}</h2>
          <p class="lead mt-5 max-w-[48ch]">{t.trust.text}</p>
        </div>
        <ul class="vd-trust">
          {
            t.trust.features.map((feature, index) => (
              <li data-reveal style={`--d:${(index % 2) * 70}ms`}>
                <span class="vd-trust-icon">
                  <Icon name={trustIcons[index]} size={18} />
                </span>
                <div>
                  <p class="vd-list-title">{feature.title}</p>
                  <p class="vd-list-text">{feature.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="cambio" class="vd-section" data-spine="0.5" aria-labelledby="cambio-title">
    <div class="wrap">
      <div class="vd-head">
        <p class="eyebrow vd-eyebrow-teal">{t.move.kicker}</p>
        <h2 id="cambio-title" class="display h-lg mt-4 max-w-[16ch]">{t.move.title}</h2>
        <p class="lead mt-5 max-w-[60ch]">{t.move.text}</p>
      </div>
      <ol class="vd-steps mt-12">
        {
          t.move.steps.map((step, index) => (
            <li class="vd-step" data-reveal style={`--d:${index * 90}ms`}>
              <span class="vd-step-n" aria-hidden="true">{index + 1}</span>
              <p class="vd-step-title">{step.title}</p>
              <p class="vd-step-text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="rust" class="vd-section vd-dark vd-built" data-dark data-spine="0.405" aria-labelledby="rust-title">
    <div class="wrap vd-split">
      <div class="vd-head">
        <p class="eyebrow vd-eyebrow">{t.built.kicker}</p>
        <h2 id="rust-title" class="display h-lg mt-4 max-w-[15ch]">{t.built.title}</h2>
        <p class="vd-lead mt-5">{t.built.text}</p>
        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
          <a href={serviceHref('aplicaciones-escritorio', lang)} class="link-arrow vd-link">
            {t.built.service} <Icon name="arrow" size={16} />
          </a>
          <a href={techHref('rust', lang)} class="link-arrow vd-link">
            {t.built.rust} <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
      <ul class="vd-built-list">
        {
          t.built.features.map((feature, index) => (
            <li data-reveal style={`--d:${index * 80}ms`}>
              <p class="vd-card-title">{feature.title}</p>
              <p class="vd-card-text">{feature.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="border-t border-line">
    <Faq items={t.faq} title={t.faqTitle} />
  </div>

  <CtaBand title={t.ctaTitle} text={t.ctaText} label={t.cta} />
</BaseLayout>

<style>
  /* ── The program's own colours, inside the site's frame ─────────────── */
  .vd-hero,
  .vd-dark {
    --vd-night: #0d1c31;
    color: #eef2f7;
    background-color: var(--vd-night);
  }
  .vd-hero {
    position: relative;
    margin-top: -68px;
    padding: calc(68px + 1.5rem) 0 clamp(4rem, 8vw, 6rem);
    background:
      radial-gradient(820px 520px at 78% 22%, rgb(45 212 191 / 0.2), transparent 70%),
      radial-gradient(700px 520px at 6% 4%, rgb(37 99 235 / 0.2), transparent 70%),
      radial-gradient(900px 500px at 50% 100%, rgb(45 212 191 / 0.12), transparent 70%),
      #0d1c31;
    overflow-x: clip;
  }
  .vd-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #7f90aa;
  }
  .vd-crumbs li {
    display: flex;
    gap: 0.5rem;
  }
  .vd-crumbs a:hover,
  .vd-crumbs [aria-current] {
    color: #eef2f7;
  }
  .vd-hero-grid {
    margin-top: 2.5rem;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .vd-hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: 3rem;
    }
  }
  .vd-eyebrow {
    color: #9fb0c8;
  }
  .vd-eyebrow::before,
  .vd-eyebrow-teal::before {
    background: #2dd4bf;
  }
  .vd-eyebrow-teal::before {
    background: #0d9488;
  }
  .vd-h1 {
    font-size: clamp(2.6rem, 5.6vw, 5.2rem);
    max-width: 12ch;
    color: #f7f3ea;
  }
  .vd-h1 em,
  .vd-dark :global(.display em),
  .vd-hero :global(.display em) {
    color: #5eead4;
  }
  .vd-lead {
    max-width: 56ch;
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    line-height: 1.6;
    color: #c9d4e3;
    text-wrap: pretty;
  }
  .vd-btn {
    color: #04221f;
    background: #2dd4bf;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 12px 30px -12px rgb(45 212 191 / 0.9);
  }
  .vd-btn:hover {
    background: #5eead4;
  }
  .vd-btn-ghost {
    color: #eef2f7;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
  }
  .vd-btn-ghost:hover {
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.5);
  }
  .vd-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .vd-chips li {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: #c9d4e3;
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .vd-hero-arch {
    max-width: 600px;
    width: 100%;
    margin-inline: auto;
  }
  /* The program rises out of the hero and lies flat as it comes up the screen. */
  .vd-hero-shot {
    margin-top: clamp(3rem, 6vw, 5rem);
    perspective: 2200px;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .vd-hero-shot :global(.vd-window) {
        transform-origin: center top;
        animation: vd-lay linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }
  @keyframes vd-lay {
    from {
      transform: rotateX(24deg) scale(0.92);
      opacity: 0.6;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  /* ── Facts under the hero ─────────────────────────────────────────── */
  .vd-facts {
    padding-block: clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--color-line);
  }
  .vd-facts-grid {
    display: grid;
    gap: 1.25rem 2rem;
  }
  @media (min-width: 640px) {
    .vd-facts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .vd-facts-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .vd-fact-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    color: #0f766e;
    background: rgb(13 148 136 / 0.12);
  }
  .vd-fact-title {
    margin-top: 0.9rem;
    font-weight: 600;
    font-size: 16px;
  }
  .vd-fact-text {
    margin-top: 0.3rem;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  /* ── Page index: a row of links that stays at hand ─────────────────── */
  .vd-toc {
    position: sticky;
    /* under the site header, which is sticky too and 68px tall */
    top: 68px;
    z-index: 20;
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .vd-toc ul {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    padding-block: 0.6rem;
    scrollbar-width: none;
  }
  .vd-toc ul::-webkit-scrollbar {
    display: none;
  }
  .vd-toc a {
    display: block;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 540;
    white-space: nowrap;
    color: var(--color-ink-2);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .vd-toc a:hover,
  .vd-toc a[aria-current='true'] {
    color: #0f766e;
    background: rgb(13 148 136 / 0.1);
  }

  /* ── Sections ─────────────────────────────────────────────────────── */
  .vd-section {
    position: relative;
    padding-block: clamp(5rem, 10vw, 8rem);
    /* the header and the row of links both stay on top */
    scroll-margin-top: 7.5rem;
  }
  .vd-section--line {
    border-top: 1px solid var(--color-line);
  }
  .vd-section--tint {
    background: linear-gradient(180deg, #e8f2ef, var(--color-paper));
  }
  .vd-dark {
    background:
      radial-gradient(760px 480px at 90% 10%, rgb(45 212 191 / 0.14), transparent 70%),
      radial-gradient(700px 480px at 0% 100%, rgb(37 99 235 / 0.14), transparent 70%),
      #0d1c31;
  }
  .vd-dark :global(.lead) {
    color: #c9d4e3;
  }
  .vd-eyebrow-teal {
    color: #0f766e;
  }
  .vd-split {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .vd-split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
    }
    .vd-split--even {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .vd-tilt {
    perspective: 1800px;
  }
  .vd-tilt :global(.vd-window) {
    transform: rotateY(-10deg) rotateX(3deg);
    transform-origin: left center;
    transition: transform 1s var(--ease-out-soft);
  }
  .vd-tilt:hover :global(.vd-window) {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .vd-tilt :global(.vd-window) {
      transform: none;
    }
  }

  .vd-cards {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .vd-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .vd-cards--dark {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .vd-cards:not(.vd-cards--dark) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .vd-card {
    padding: 1.4rem 1.4rem 1.5rem;
    border-radius: 20px;
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  /* Opaque, so the site's fibre line runs behind them, not through them. */
  .vd-cards--dark .vd-card {
    background: #13243b;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .vd-card-title {
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.3;
  }
  .vd-card-text {
    margin-top: 0.5rem;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .vd-dark .vd-card-text {
    color: #b3c1d4;
  }

  .vd-list {
    display: grid;
    gap: 1.25rem;
  }
  .vd-list li {
    padding-left: 1.1rem;
    border-left: 2px solid rgb(13 148 136 / 0.45);
  }
  .vd-list-title {
    font-weight: 600;
    font-size: 16px;
  }
  .vd-list-text {
    margin-top: 0.25rem;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  .vd-trust {
    display: grid;
    gap: 1.5rem 2rem;
  }
  @media (min-width: 720px) {
    .vd-trust {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .vd-trust li {
    display: flex;
    gap: 0.9rem;
  }
  .vd-trust-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
