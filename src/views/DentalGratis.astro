---
// /programa-gestion-dental-gratis/ and /en/free-dental-software/: the page for the
// "free dental software" search (see src/data/dental-gratis.ts). Dark hero with the
// price that matters (0) and the download; then each question in its own section,
// answer first; the checklist as a real table; the installers; and the FAQ.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import AppShot from '../components/veodardental/AppShot.astro';
import Download from '../components/veodardental/Download.astro';
import { freeFor } from '../data/dental-gratis';
import { VD_RELEASES, VD_VERSION, vdFor } from '../data/veodardental';
import { shots } from '../components/veodardental/shots';
import { sectorsFor } from '../data/sectors';
import { breadcrumbLd, faqLd, site } from '../data/site';
import { langOf, pathTo, sectorHref } from '../i18n';
import { UPDATED } from '../data/updated';

const lang = langOf(Astro.url);
const t = freeFor(lang);
const vd = vdFor(lang);
const health = sectorsFor(lang).find((s) => s.id === 'salud')!;
const url = new URL(pathTo('dentalGratis', lang), site.url).href;
const product = new URL(pathTo('veodardental', lang), site.url).href;
const T = {
  es: { home: 'Inicio', sectors: 'Sectores', downloadTitle: 'Descarga el programa dental gratis', github: 'Código y versiones' },
  en: { home: 'Home', sectors: 'Industries', downloadTitle: 'Download the free dental software', github: 'Code and releases' },
}[lang];
const crumbs = [
  { name: T.home, path: pathTo('home', lang) },
  { name: T.sectors, path: pathTo('sectores', lang) },
  { name: health.name, path: sectorHref('salud', lang) },
  { name: 'VeodarDental', path: pathTo('veodardental', lang) },
  { name: t.crumb, path: pathTo('dentalGratis', lang) },
];
// The same program as the brand page (same @id), seen from here: free, downloadable.
const appLd = {
  '@type': 'SoftwareApplication',
  '@id': `${product}#software`,
  name: 'VeodarDental',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: lang === 'en' ? 'Dental practice management' : 'Gestión de clínicas dentales',
  operatingSystem: 'Windows 10, Windows 11, macOS 11+, Linux',
  softwareVersion: VD_VERSION,
  downloadUrl: `${VD_RELEASES}/tag/v${VD_VERSION}`,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', url: `${url}#descargar` },
  description: t.lead,
  url: product,
  inLanguage: ['es', 'ca', 'eu', 'gl', 'en'],
  publisher: { '@id': `${site.url}/#organization` },
  screenshot: Object.values(shots).map((image) => new URL(image.src, site.url).href),
  featureList: t.includes.groups.flatMap((g) => g.items),
};
const ld = [breadcrumbLd(crumbs), faqLd(t.faq), appLd];
const groupIcons = ['cross', 'phone', 'bank', 'layers', 'shield'];
---

<BaseLayout title={t.title} description={t.description} jsonLd={ld} darkHero updated={UPDATED.dentalGratis} mainEntity={`${product}#software`} ogImage={lang === 'en' ? '/og-veodardental-en.png' : '/og-veodardental.png'}>
  <section class="fg-hero" data-dark data-spine="0.5" aria-labelledby="fg-title">
    <div class="wrap">
      <nav aria-label={lang === 'en' ? 'Breadcrumb' : 'Migas de pan'} class="fg-crumbs">
        <ol>
          {
            crumbs.map((crumb, index) => (
              <li>
                {index > 0 && <span aria-hidden="true">/</span>}
                {index < crumbs.length - 1 ? <a href={crumb.path}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="fg-hero-grid">
        <div>
          <p class="eyebrow fg-eyebrow" data-reveal>{t.kicker}</p>
          <h1 id="fg-title" class="display fg-h1 mt-6" data-reveal style="--d:60ms">{t.h1}</h1>
          <p class="fg-lead mt-7" data-reveal style="--d:120ms">{t.lead}</p>
          <ul class="fg-chips mt-9" data-reveal style="--d:180ms">
            {
              t.chips.map((chip) => (
                <li>
                  <Icon name="check" size={13} />
                  {chip}
                </li>
              ))
            }
          </ul>
        </div>
        <aside class="fg-price" data-reveal style="--d:120ms" aria-label={t.ctaDownload}>
          <p class="fg-price-amount"><span>0</span> €</p>
          <p class="fg-price-label">{t.priceLabel}</p>
          <p class="fg-price-note">{t.priceNote}</p>
          <a href="#descargar" class="btn fg-btn mt-6">
            {t.ctaDownload}
            <svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3.5v9M6.2 8.8 10 12.6l3.8-3.8M4 16.5h12" /></svg>
          </a>
          <a href={pathTo('veodardental', lang, 'pantallas')} class="fg-price-link">{t.ctaProgram} <Icon name="arrow" size={14} /></a>
          <p class="fg-price-os">Windows · macOS · Linux · v{VD_VERSION}</p>
        </aside>
      </div>
      <div class="fg-shot" data-reveal style="--d:200ms">
        <AppShot shot="agenda" dark eager sizes="(min-width: 1320px) 1240px, 94vw" />
      </div>
    </div>
  </section>

  <section class="fg-section" data-spine="0.5" aria-labelledby="fg-free">
    <div class="wrap fg-split">
      <div class="fg-head">
        <h2 id="fg-free" class="display h-lg max-w-[16ch]">{t.free.title}</h2>
        <p class="fg-answer mt-5">{t.free.answer}</p>
        <p class="fg-text mt-4">{t.free.text}</p>
      </div>
      <div class="fg-pay">
        <div class="fg-pay-col fg-pay-col--free">
          <p class="fg-pay-title">{t.free.freeTitle}</p>
          <ul>{t.free.free.map((item) => <li><Icon name="check" size={13} />{item}</li>)}</ul>
        </div>
        <div class="fg-pay-col">
          <p class="fg-pay-title">{t.free.paidTitle}</p>
          <ul>{t.free.paid.map((item) => <li><span class="fg-dot" aria-hidden="true"></span>{item}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="fg-section fg-section--tint" data-spine="0.5" aria-labelledby="fg-includes">
    <div class="wrap">
      <div class="fg-head">
        <h2 id="fg-includes" class="display h-lg max-w-[20ch]">{t.includes.title}</h2>
        <p class="fg-answer mt-5 max-w-[66ch]">{t.includes.answer}</p>
      </div>
      <ul class="fg-groups mt-10">
        {
          t.includes.groups.map((group, index) => (
            <li class="fg-group" data-reveal style={`--d:${index * 60}ms`}>
              <span class="fg-group-icon"><Icon name={groupIcons[index]} size={18} /></span>
              <h3 class="fg-group-name">{group.name}</h3>
              <ul class="fg-group-items">{group.items.map((item) => <li>{item}</li>)}</ul>
            </li>
          ))
        }
      </ul>
      <a href={pathTo('veodardental', lang, 'programa')} class="link-arrow fg-link mt-8">{t.includes.more} <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <section class="fg-section" data-spine="0.5" aria-labelledby="fg-choose">
    <div class="wrap">
      <div class="fg-head">
        <h2 id="fg-choose" class="display h-lg max-w-[22ch]">{t.choose.title}</h2>
        <p class="fg-answer mt-5 max-w-[70ch]">{t.choose.answer}</p>
      </div>
      <div class="fg-table-wrap mt-10">
        <table class="fg-table">
          <thead>
            <tr>{t.choose.head.map((h) => <th scope="col">{h}</th>)}</tr>
          </thead>
          <tbody>
            {
              t.choose.rows.map((row) => (
                <tr>
                  <th scope="row">{row.what}</th>
                  <td data-label={t.choose.head[1]}>{row.why}</td>
                  <td data-label={t.choose.head[2]} class="fg-vd">
                    <Icon name="check" size={13} />
                    {row.vd}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="fg-text mt-8 max-w-[66ch]">{t.choose.after}</p>
    </div>
  </section>

  <section class="fg-section fg-section--line" data-spine="0.5" aria-labelledby="fg-start">
    <div class="wrap">
      <div class="fg-head">
        <h2 id="fg-start" class="display h-lg max-w-[18ch]">{t.start.title}</h2>
        <p class="fg-answer mt-5 max-w-[66ch]">{t.start.answer}</p>
      </div>
      <ol class="fg-steps mt-10">
        {
          t.start.steps.map((step, index) => (
            <li class="fg-step" data-reveal style={`--d:${index * 80}ms`}>
              <span class="fg-step-n" aria-hidden="true">{index + 1}</span>
              <h3 class="fg-step-title">{step.title}</h3>
              <p class="fg-step-text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="descargar" class="fg-section fg-section--tint" data-spine="0.5" aria-labelledby="fg-download">
    <div class="wrap">
      <div class="fg-head">
        <h2 id="fg-download" class="display h-lg max-w-[20ch]">{T.downloadTitle}</h2>
        <p class="fg-answer mt-5 max-w-[66ch]">{vd.download.text}</p>
      </div>
      <div class="mt-10">
        <Download />
      </div>
    </div>
  </section>

  <section class="fg-section fg-dark" data-dark data-spine="0.405" aria-labelledby="fg-spain">
    <div class="wrap fg-split">
      <div class="fg-head">
        <h2 id="fg-spain" class="display h-lg max-w-[16ch]">{t.spain.title}</h2>
        <p class="fg-answer fg-answer--dark mt-5">{t.spain.answer}</p>
      </div>
      <ul class="fg-spain">
        {
          t.spain.points.map((point, index) => (
            <li data-reveal style={`--d:${(index % 2) * 70}ms`}>
              <Icon name="check" size={14} />
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="fg-section" data-spine="0.5" aria-labelledby="fg-why">
    <div class="wrap fg-why">
      <h2 id="fg-why" class="display h-lg">{t.why.title}</h2>
      <div>
        <p class="fg-answer">{t.why.answer}</p>
        <p class="fg-text mt-4">{t.why.text}</p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          <a href={pathTo('veodardental', lang, 'pantallas')} class="link-arrow fg-link">{t.ctaProgram} <Icon name="arrow" size={16} /></a>
          <a href="https://github.com/jorgellb/veodardental" target="_blank" rel="noopener" class="link-arrow fg-link">{t.why.code} <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-line">
    <Faq items={t.faq} title={t.faqTitle} />
  </div>

  <CtaBand title={t.ctaTitle} text={t.ctaText} label={vd.cta} />
</BaseLayout>

<style>
  .fg-hero,
  .fg-dark {
    color: #edf3f1;
    background-color: #081a16;
  }
  .fg-hero {
    position: relative;
    margin-top: -68px;
    padding: calc(68px + 1.5rem) 0 clamp(4rem, 8vw, 6rem);
    background:
      radial-gradient(820px 520px at 80% 18%, rgb(60 207 168 / 0.22), transparent 70%),
      radial-gradient(700px 520px at 4% 4%, rgb(52 120 150 / 0.2), transparent 70%),
      #081a16;
    overflow-x: clip;
  }
  .fg-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #80a097;
  }
  .fg-crumbs li {
    display: flex;
    gap: 0.5rem;
  }
  .fg-crumbs a:hover,
  .fg-crumbs [aria-current] {
    color: #edf3f1;
  }
  .fg-hero-grid {
    margin-top: 2.5rem;
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .fg-hero-grid {
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 4rem;
    }
  }
  .fg-eyebrow {
    color: #9fbdb4;
  }
  .fg-eyebrow::before {
    background: #3ccfa8;
  }
  .fg-h1 {
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    max-width: 16ch;
    color: #f7f3ea;
  }
  .fg-lead {
    max-width: 60ch;
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    line-height: 1.6;
    color: #c6d9d3;
    text-wrap: pretty;
  }
  .fg-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .fg-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 13.5px;
    color: #d6f5ef;
    background: rgb(60 207 168 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(60 207 168 / 0.3);
  }
  .fg-chips li :global(svg) {
    color: #7ee0c3;
  }
  .fg-price {
    padding: 1.75rem;
    border-radius: 26px;
    text-align: center;
    background: #0f2a24;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 30px 70px -30px rgb(0 0 0 / 0.7),
      0 0 120px -40px rgb(60 207 168 / 0.5);
  }
  .fg-price-amount {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1;
    color: #7ee0c3;
  }
  .fg-price-amount span {
    font-size: 6.5rem;
    letter-spacing: -0.04em;
    color: #f7f3ea;
  }
  .fg-price-label {
    margin-top: 0.5rem;
    font-size: 15px;
    color: #c6d9d3;
  }
  .fg-price-note {
    margin-top: 0.3rem;
    font-size: 13.5px;
    color: #9fbdb4;
  }
  .fg-btn {
    width: 100%;
    justify-content: center;
    color: #04221f;
    background: #3ccfa8;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 12px 30px -12px rgb(60 207 168 / 0.9);
  }
  .fg-btn:hover {
    background: #7ee0c3;
  }
  .fg-price-link {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 14px;
    color: #7ee0c3;
  }
  .fg-price-os {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: #80a097;
  }
  .fg-shot {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .fg-section {
    position: relative;
    padding-block: clamp(4.5rem, 9vw, 7rem);
    scroll-margin-top: 5rem;
  }
  .fg-section--tint {
    background: linear-gradient(180deg, #e8f2ef, var(--color-paper));
  }
  .fg-section--line {
    border-top: 1px solid var(--color-line);
  }
  .fg-dark {
    background:
      radial-gradient(760px 480px at 90% 10%, rgb(60 207 168 / 0.14), transparent 70%),
      #081a16;
  }
  .fg-split {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .fg-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .fg-answer {
    font-size: clamp(1.05rem, 1.3vw, 1.18rem);
    line-height: 1.6;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .fg-answer--dark {
    color: #c6d9d3;
  }
  .fg-text {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .fg-link {
    color: #075a4d;
  }
  .fg-dark .fg-link {
    color: #7ee0c3;
  }

  .fg-pay {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .fg-pay {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .fg-pay-col {
    padding: 1.4rem;
    border-radius: 22px;
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .fg-pay-col--free {
    color: #edf3f1;
    background: #081a16;
    box-shadow: 0 24px 50px -28px rgb(8 26 22 / 0.8);
  }
  .fg-pay-title {
    font-weight: 600;
    font-size: 16px;
  }
  .fg-pay-col ul {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.6rem;
  }
  .fg-pay-col li {
    display: flex;
    gap: 0.55rem;
    align-items: baseline;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .fg-pay-col--free li {
    color: #c6d9d3;
  }
  .fg-pay-col--free li :global(svg) {
    flex: none;
    color: #7ee0c3;
    transform: translateY(2px);
  }
  .fg-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #94a3b8;
    transform: translateY(-1px);
  }

  .fg-groups {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .fg-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .fg-groups {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .fg-group {
    padding: 1.3rem;
    border-radius: 22px;
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .fg-group-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    color: #7ee0c3;
    background: #081a16;
  }
  .fg-group-name {
    margin-top: 0.9rem;
    font-weight: 600;
    font-size: 16.5px;
  }
  .fg-group-items {
    margin-top: 0.6rem;
    display: grid;
    gap: 0.35rem;
  }
  .fg-group-items li {
    position: relative;
    padding-left: 0.95rem;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .fg-group-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #0a7564;
  }

  .fg-table-wrap {
    border-radius: 22px;
    overflow: hidden;
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .fg-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    line-height: 1.5;
  }
  .fg-table thead th {
    padding: 0.9rem 1.2rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: rgb(8 26 22 / 0.03);
  }
  .fg-table tbody tr + tr {
    border-top: 1px solid var(--color-line);
  }
  .fg-table th[scope='row'] {
    padding: 1rem 1.2rem;
    text-align: left;
    font-weight: 600;
    vertical-align: top;
  }
  .fg-table td {
    padding: 1rem 1.2rem;
    vertical-align: top;
    color: var(--color-ink-2);
  }
  .fg-vd {
    color: var(--color-ink) !important;
  }
  .fg-vd :global(svg) {
    display: inline;
    margin-right: 0.35rem;
    color: #0a7564;
    vertical-align: -1px;
  }
  /* On a phone each row becomes a card, with the column name above each cell. */
  @media (max-width: 720px) {
    .fg-table thead {
      display: none;
    }
    .fg-table,
    .fg-table tbody,
    .fg-table tr,
    .fg-table th,
    .fg-table td {
      display: block;
    }
    .fg-table th[scope='row'] {
      padding-bottom: 0.2rem;
    }
    .fg-table td {
      padding-top: 0.35rem;
      padding-bottom: 0.35rem;
    }
    .fg-table td::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-mono);
      font-size: 10.5px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    .fg-table tr {
      padding-bottom: 0.7rem;
    }
  }

  .fg-steps {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .fg-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .fg-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .fg-step {
    padding: 1.4rem;
    border-radius: 20px;
    background: var(--color-card);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .fg-step-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-weight: 600;
    color: #fff;
    background: #0a7564;
