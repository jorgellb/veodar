---
import SectorPage from '../../views/SectorPage.astro';
import { sectorsFor } from '../../data/sectors';

export function getStaticPaths() {
  return sectorsFor('es').map((sector) => ({ params: { slug: sector.id }, props: { sector } }));
}
const { sector } = Astro.props;
---

<SectorPage sector={sector} />
