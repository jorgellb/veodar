---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, serviceHref } from '../../data/services';
import { breadcrumbLd, site } from '../../data/site';

const ld = [
  breadcrumbLd([
    { name: 'Inicio', path: '/' },
    { name: 'Servicios', path: '/servicios/' },
  ]),
  {
    '@type': 'ItemList',
    name: 'Servicios de Veodar',
    itemListElement: services.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: service.name,
      url: new URL(serviceHref(service.slug), site.url).href,
    })),
  },
];
---

<BaseLayout
  title="Servicios: IA, desarrollo web, apps, diseño, 3D y SEO"
  description="Doce servicios de un mismo equipo: automatizaciones con IA, desarrollo web, apps móviles y de escritorio, identidad de marca, diseño web, desarrollo creativo, 3D, configuradores, vídeo, rediseño y SEO."
  jsonLd={ld}
>
  <section class="pt-14 pb-10 md:pt-20">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Servicios</p>
      <h1 class="display h-hero mt-6 max-w-[12ch]" data-reveal style="--d:60ms">Todo lo que <em>construimos</em>.</h1>
      <p class="lead mt-7 max-w-[56ch]" data-reveal style="--d:120ms">
        Ingeniería para poner el software y la IA a trabajar. Estudio para que se entienda, se recuerde y se encuentre. Elige un servicio o cuéntanos el problema y proponemos el formato.
      </p>
    </div>
  </section>
  <section class="pb-24 md:pb-32" aria-label="Lista de servicios">
    <div class="wrap">
      <ServiceGrid headingLevel="h2" />
    </div>
  </section>
  <CtaBand />
</BaseLayout>
