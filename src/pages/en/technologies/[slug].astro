---
import TechPage from '../../../views/TechPage.astro';
import { techsFor } from '../../../data/technologies';
import { TECH_SLUGS } from '../../../i18n';

export function getStaticPaths() {
  return techsFor('en').map((tech) => ({ params: { slug: TECH_SLUGS[tech.id] }, props: { tech } }));
}
const { tech } = Astro.props;
---

<TechPage tech={tech} />
