---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Pillars from '../components/home/Pillars.astro';
import Process from '../components/home/Process.astro';
import Principles from '../components/home/Principles.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { services, serviceHref } from '../data/services';
import { faqLd, site } from '../data/site';

const faq = [
  {
    q: '¿Qué tipo de automatizaciones con IA hacéis?',
    a: 'Tareas concretas que ya existen y se repiten: clasificar correos y tickets, extraer datos de documentos y facturas, preparar borradores de respuesta, conciliar pedidos o avisar cuando algo no cuadra. Usamos agentes y flujos conectados a vuestro ERP, CRM o correo, con una persona o una regla que confirma antes de publicar.',
  },
  {
    q: '¿Con qué modelos de IA trabajáis?',
    a: 'Con el que mejor resuelva la tarea: Claude, GPT, Gemini o modelos abiertos alojados por vosotros. Conectamos herramientas con MCP y orquestamos con LangGraph, n8n o código propio. La tarea y las reglas no quedan atadas a un proveedor.',
  },
  {
    q: '¿Web, app móvil o aplicación de escritorio?',
    a: 'Lo decide el trabajo. Web si hay cuentas, permisos y un dato que otro sistema lee mañana; móvil si alguien registra el trabajo de pie y sin cobertura; escritorio si el puesto depende de archivos locales o aparatos. Si no encaja ninguno, lo decimos.',
  },
  {
    q: '¿Quién es el propietario del código?',
    a: 'Vuestra empresa. El repositorio, el dominio, las cuentas de nube y las de las tiendas de aplicaciones se crean a vuestro nombre. Entregamos la guía de despliegue para que otro equipo pueda seguir sin nosotros.',
  },
  {
    q: '¿Cuánto cuesta un proyecto?',
    a: 'Depende del alcance: roles y permisos, integraciones, trabajo sin conexión, publicación en tiendas o el nivel de autonomía de la IA. No publicamos tarifa; en la primera respuesta os decimos si encaja y qué habría que acotar para dar una cifra cerrada.',
  },
  {
    q: '¿Trabajáis con empresas fuera de España?',
    a: 'Sí, en castellano, con equipos en España y Latinoamérica. El método no cambia con la distancia: ejemplo real, alcance escrito y un primer corte que alguien usa.',
  },
  {
    q: '¿También hacéis diseño, 3D y SEO?',
    a: 'Sí. Nuestro estudio cubre identidad de marca, diseño web, desarrollo creativo, webs 3D, configuradores, vídeos de lanzamiento, rediseños sin perder posicionamiento y SEO con visibilidad en buscadores de IA.',
  },
];

const ld = [
  {
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#service`,
    name: 'Veodar',
    url: `${site.url}/`,
    email: site.email,
    description: site.description,
    provider: { '@id': `${site.url}/#organization` },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Servicios de Veodar',
      itemListElement: services.map((service) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: service.name,
          description: service.description,
          url: new URL(serviceHref(service.slug), site.url).href,
        },
      })),
    },
  },
  faqLd(faq),
];
---

<BaseLayout
  title="Veodar · Automatizaciones con IA y desarrollo de software a medida"
  description="Automatizaciones con IA, desarrollo web, apps móviles y de escritorio, diseño, 3D y SEO. Un mismo equipo diseña y construye; el código y las cuentas, a nombre de tu empresa."
  jsonLd={ld}
  darkHero
>
  <Hero />
  <Pillars />

  <section id="servicios" class="bg-paper-2/60 py-24 md:py-36" data-spine="0.5" aria-labelledby="services-title">
    <div class="wrap">
      <div class="grid gap-8 md:grid-cols-[1.2fr_1fr] md:items-end">
        <div data-reveal>
          <p class="eyebrow">Servicios</p>
          <h2 id="services-title" class="display h-xl mt-5 max-w-[15ch]">Doce servicios. <em>Un</em> equipo que los une.</h2>
        </div>
        <div data-reveal style="--d:100ms">
          <p class="lead max-w-[44ch]">
            La ingeniería pone el software a trabajar. El estudio hace que se entienda, se recuerde y se encuentre.
          </p>
          <a href="/servicios/" class="link-arrow mt-5">Ver todos los servicios <Icon name="arrow" size={16} /></a>
        </div>
      </div>
      <div class="mt-16">
        <ServiceGrid />
      </div>
    </div>
  </section>

  <Process />
  <Principles />
  <Faq items={faq} />
  <CtaBand />
</BaseLayout>
