---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, organizationLdFor, websiteLd } from '../data/site';
import { alternatesOf, htmlLang, langOf, ogLocale, LANGS } from '../i18n';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
  noindex?: boolean;
  darkHero?: boolean;
  /** schema.org type of the page itself: WebPage, CollectionPage, ContactPage, AboutPage… */
  pageType?: string;
}

const { title, description, jsonLd = [], ogImage = '/og.png', noindex = false, darkHero = false, pageType = 'WebPage' } = Astro.props;
const lang = langOf(Astro.url);
const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, origin);
const image = new URL(ogImage, origin);
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
// The same page in the other language: hreflang pairs, plus x-default on the Spanish one.
const alternates = noindex ? null : alternatesOf(Astro.url.pathname);
const otherLang = LANGS.find((code) => code !== lang)!;
const webPageLd = {
  '@type': pageType,
  '@id': `${canonical.href}#webpage`,
  url: canonical.href,
  name: fullTitle,
  description,
  inLanguage: htmlLang[lang],
  isPartOf: { '@id': `${site.url}/#website` },
  about: { '@id': `${site.url}/#organization` },
  dateModified: new Date().toISOString().slice(0, 10),
};
const graph = {
  '@context': 'https://schema.org',
  '@graph': [organizationLdFor(lang), websiteLd, ...(noindex ? [] : [webPageLd]), ...jsonLd],
};
const skip = { es: 'Saltar al contenido', en: 'Skip to content' }[lang];
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="es" href={new URL(alternates.es, origin).href} />
          <link rel="alternate" hreflang="en" href={new URL(alternates.en, origin).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, origin).href} />
        </>
      )
    }
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <meta name="theme-color" content={darkHero ? '#121026' : '#f4f0e6'} />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates && <meta property="og:locale:alternate" content={ogLocale[otherLang]} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-screen overflow-x-clip">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
      >{skip}</a
    >
    <Nav tone={darkHero ? 'dark' : 'light'} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <canvas class="net-canvas" data-network aria-hidden="true"></canvas>
    <!-- Vercel: visits (Web Analytics) and real-user Core Web Vitals (Speed Insights).
         Both are cookieless and only collect on the deployed site. They live in the body,
         not the head: their custom elements would close the head early. -->
    <Analytics />
    <SpeedInsights />
    <script>
      import { startNetwork } from '../scripts/network';

      const net = document.querySelector<HTMLCanvasElement>('[data-network]');
      // Start once fonts have settled so the fibre plugs into final card positions.
      if (net) document.fonts.ready.then(() => requestAnimationFrame(() => startNetwork(net)));
    </script>
    <script>
      // Split display headings into words so each can rise out of its mask.
      const splitWords = (el: HTMLElement) => {
        let i = 0;
        const wrap = (word: string, holder?: Element) => {
          const w = document.createElement('span');
          w.className = 'w';
          const inner = document.createElement('span');
          inner.style.setProperty('--i', String(i++));
          if (holder) {
            const clone = holder.cloneNode(false) as Element;
            clone.textContent = word;
            inner.appendChild(clone);
          } else inner.textContent = word;
          w.appendChild(inner);
          return w;
        };
        const nodes = [...el.childNodes];
        el.textContent = '';
        // Text glued to the previous word (the "." after an <em>) joins that word's
        // mask, so a line can never break between a word and its punctuation.
        let glued = false;
        for (const node of nodes) {
          const text = node.textContent ?? '';
          const holder = node.nodeType === Node.ELEMENT_NODE ? (node as Element) : undefined;
          text.split(/(\s+)/).forEach((part) => {
            if (!part) return;
            if (/^\s+$/.test(part)) {
              el.appendChild(document.createTextNode(' '));
              glued = false;
              return;
            }
            const last = el.lastElementChild;
            if (glued && !holder && last?.classList.contains('w')) last.firstElementChild!.append(part);
            else el.appendChild(wrap(part, holder));
            glued = true;
          });
        }
        el.setAttribute('aria-label', el.textContent ?? '');
      };
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLElement>('h1.display, h2.display').forEach((el) => {
          el.setAttribute('data-split', '');
          if (!el.hasAttribute('data-reveal')) el.setAttribute('data-reveal', '');
          splitWords(el);
        });
      }

      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        },
        // Any sliver counts: tall blocks (the hero machine) never reach a ratio threshold.
        { rootMargin: '0px 0px -5% 0px', threshold: 0 },
      );
      items.forEach((item) => io.observe(item));

      // Pointer spotlight on cards.
      document.addEventListener('pointermove', (event) => {
        const card = (event.target as Element | null)?.closest?.<HTMLElement>('.spot');
        if (!card) return;
        const box = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${event.clientX - box.left}px`);
        card.style.setProperty('--my', `${event.clientY - box.top}px`);
      });
    </script>
  </body>
</html>
